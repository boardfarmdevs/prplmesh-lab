# prplMesh lab paths for the shared, read-only wmediumd Console.
WMEDIUMD_CONSOLE_LISTEN=0.0.0.0:8090
WMEDIUMD_CONSOLE_SOCKET=/run/prpl-wmediumd/telemetry.sock
WMEDIUMD_CONSOLE_IDENTITY_INVENTORY=/run/prpl-wmediumd/identity-inventory.json
WMEDIUMD_CONSOLE_CONFIG=/run/prpl-wmediumd/wmediumd.conf
WMEDIUMD_CONSOLE_PID_FILE=/run/prpl-wmediumd/wmediumd.pid
WMEDIUMD_CONSOLE_DAEMON_MANIFEST=/run/prpl-wmediumd/wmediumd-binary.sha256
WMEDIUMD_CONSOLE_EXTRA_ARGS=
