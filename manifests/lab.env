# Pinned experiment identity. Scripts source this file; it is not discovered
# from unrelated LXD objects on the host.
PRPL_RELEASE=6.0.0
PRPL_COMMIT=2e153c7e00cbcab6b8ee35082f494a364e23f018
HOSTAP_COMMIT=${HOSTAP_COMMIT:-cff80b4f7d3c0a47c052e8187d671710f48939e4}
WMEDIUMD_COMMIT=${WMEDIUMD_COMMIT:-717e5d7fcc23eecbc8e32bd897a8fd4b1e3ba640}
BUILD_CONTAINER=${BUILD_CONTAINER:-prpl-build}
CONTROLLER_CONTAINER=prpl-controller
AGENT_CONTAINER=prpl-agent-01
CLIENT_CONTAINER=prpl-client-01
MANAGEMENT_NETWORK=prplbr0
BACKHAUL_NETWORK=prplbh0
MANAGEMENT_IPV4=10.77.27.1/24
BACKHAUL_IPV4=10.77.28.1/24
CONTROLLER_AL_MAC=02:00:00:27:01:01
AGENT_AL_MAC=02:00:00:27:02:01
PROVISIONED_AGENT_COUNT=4
PROVISIONED_CLIENT_COUNT=20
ACTIVE_AGENT_COUNT=2
ACTIVE_CLIENT_COUNT=10
DEFAULT_TOPOLOGY=chain
RADIOS_PER_MESH_NODE=3
HWSIM_RADIOS=40
HWSIM_CHANNELS=3
# The proven userspace implementation remains the release default. Set
# PRPL_MEDIUM_BACKEND=kernel per invocation or in the service environment to
# select the experimental in-kernel data path without changing the manifest.
PRPL_MEDIUM_BACKEND=${PRPL_MEDIUM_BACKEND:-userspace}
# Overlap container boot, but retain the controller/mesh/client readiness
# gates. Full burst startup is deliberately not exposed as a release mode.
PRPL_START_MODE=${PRPL_START_MODE:-overlap}
PRPL_START_PARALLELISM=${PRPL_START_PARALLELISM:-10}
PRIVATE_SSID=private_ssid
IOT_SSID=iot_ssid
BACKHAUL_SSID=mesh_backhaul
WIFI_PASSPHRASE=prplmesh_pass
