#!/usr/bin/env bash
# Build this repository's Pages site into dist/site: the only per-repository step. The rest
# is the labs' shared Pages workflow (easymesh-labs .github/workflows/labs-pages.yml).
#
# prplmesh-lab: the explorer (explorer/) builds the whole public site,
# with the disconnected room viewer, manual and golden rooms; its browser tests run
# against it before it is published.
set -euo pipefail
cd "$(dirname "$(readlink -f "$0")")/.."
(
    cd explorer
    npm ci
    npm run build
    if [ -n "${CI:-}" ]; then npx playwright install --with-deps chromium; fi
    npm test
)
rm -rf dist/site
mkdir -p dist
cp -a explorer/site dist/site
echo "Built dist/site from explorer/site"
