[Unit]
Description=Interactive prplMesh room demonstration
Requires=prplmesh-lab.service
After=prplmesh-lab.service prplmesh-controller-ui.service
ConditionPathExists=!/var/lib/prplmesh-lab/thin-profile-selection.required
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=/opt/prplmesh-lab
Environment=PYTHONUNBUFFERED=1
ExecCondition=/usr/bin/grep -qx PROVISIONED_CLIENT_COUNT=100 /etc/default/prplmesh-lab
ExecStart=/opt/prplmesh-lab/demo/room-demo interactive --mode act --yes-act --profiling --steering-rate-limit 300 --listen 0.0.0.0:8891 --output-root /var/lib/prplmesh-lab/room-runs
TimeoutStopSec=180
KillMode=mixed
Restart=on-failure
RestartSec=15

[Install]
WantedBy=multi-user.target prplmesh-lab.service
