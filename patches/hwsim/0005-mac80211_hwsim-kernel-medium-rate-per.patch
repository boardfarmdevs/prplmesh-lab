+/*
+ * Deliberately small deterministic approximation for laboratory experiments.
+ * It is not an RF-accurate PHY model.  The thresholds make a chosen MCS or
+ * legacy rate progressively less reliable as signal approaches the required
+ * SNR, while leaving the existing signal/cutoff/loss model unchanged unless
+ * kernel_medium_rate_per is explicitly enabled.
+ */
+static unsigned int
+hwsim_kernel_medium_rate_loss(struct mac80211_hwsim_data *source,
+			      const struct ieee80211_rx_status *status,
+			      int signal, int *snr_out, int *required_out)
+{
+	static const u8 mcs_required_snr[] = {
+		4, 7, 9, 12, 16, 20, 23, 25, 28, 30,
+	};
+	struct ieee80211_supported_band *sband;
+	int idx = status->rate_idx;
+	int nss = status->nss ? status->nss : 1;
+	int required, snr, margin;
+
+	if (status->encoding == RX_ENC_HT) {
+		nss = idx / 8 + 1;
+		idx %= 8;
+		required = mcs_required_snr[idx];
+	} else if (status->encoding == RX_ENC_VHT) {
+		idx = clamp(idx, 0, (int)ARRAY_SIZE(mcs_required_snr) - 1);
+		required = mcs_required_snr[idx];
+	} else {
+		int bitrate = 10;
+
+		sband = source->hw->wiphy->bands[status->band];
+		if (sband && idx >= 0 && idx < sband->n_bitrates)
+			bitrate = sband->bitrates[idx].bitrate;
+		if (bitrate <= 10)
+			required = 4;
+		else if (bitrate <= 20)
+			required = 5;
+		else if (bitrate <= 55)
+			required = 6;
+		else if (bitrate <= 110)
+			required = 8;
+		else if (bitrate <= 240)
+			required = 10;
+		else if (bitrate <= 360)
+			required = 12;
+		else if (bitrate <= 480)
+			required = 16;
+		else
+			required = 18;
+	}
+
+	required += 2 * max(nss - 1, 0);
+	switch (status->bw) {
+	case RATE_INFO_BW_40:
+		required += 3;
+		break;
+	case RATE_INFO_BW_80:
+		required += 6;
+		break;
+	case RATE_INFO_BW_160:
+		required += 9;
+		break;
+	default:
+		break;
+	}
+
+	snr = signal - READ_ONCE(kernel_medium_noise_floor);
+	margin = snr - required;
+	*snr_out = snr;
+	*required_out = required;
+
+	if (margin <= -6)
+		return 100;
+	if (margin == -5)
+		return 95;
+	if (margin == -4)
+		return 85;
+	if (margin == -3)
+		return 70;
+	if (margin == -2)
+		return 50;
+	if (margin == -1)
+		return 30;
+	if (margin == 0)
+		return 15;
+	if (margin == 1)
+		return 5;
+	return 0;
+}
