+static unsigned int kernel_medium_bank;
+static unsigned int kernel_medium_generation;
+
+static int hwsim_kernel_medium_bank_set(const char *value,
+					const struct kernel_param *kp)
+{
+	unsigned int bank;
+	int error;
+
+	error = kstrtouint(value, 0, &bank);
+	if (error)
+		return error;
+	if (bank >= 2)
+		return -ERANGE;
+
+	WRITE_ONCE(kernel_medium_bank, bank);
+	WRITE_ONCE(kernel_medium_generation,
+		   READ_ONCE(kernel_medium_generation) + 1);
+	return 0;
+}
+
+static const struct kernel_param_ops hwsim_kernel_medium_bank_ops = {
+	.set = hwsim_kernel_medium_bank_set,
+	.get = param_get_uint,
+};
+
+module_param_cb(kernel_medium_bank, &hwsim_kernel_medium_bank_ops,
+		&kernel_medium_bank, 0644);
+MODULE_PARM_DESC(kernel_medium_bank,
+		 "Active in-kernel medium link-matrix bank (least significant bit)");
+module_param(kernel_medium_generation, uint, 0444);
+MODULE_PARM_DESC(kernel_medium_generation,
+		 "Committed in-kernel medium matrix generation");
+
