+static const char * const hwsim_kernel_medium_band_names[] = {
+	"2.4", "5", "6",
+};
+
+static int hwsim_kernel_medium_band_slot(const char *band)
+{
+	if (!strcmp(band, "2.4") || !strcmp(band, "2g"))
+		return 0;
+	if (!strcmp(band, "5") || !strcmp(band, "5g"))
+		return 1;
+	if (!strcmp(band, "6") || !strcmp(band, "6g"))
+		return 2;
+
+	return -EINVAL;
+}
+
+static int hwsim_kernel_medium_chan_slot(enum nl80211_band band)
+{
+	switch (band) {
+	case NL80211_BAND_2GHZ:
+		return 0;
+	case NL80211_BAND_5GHZ:
+		return 1;
+	case NL80211_BAND_6GHZ:
+		return 2;
+	default:
+		return -1;
+	}
+}
+
+static int hwsim_kernel_medium_links_show(struct seq_file *m, void *unused)
+{
+	struct mac80211_hwsim_data *data = m->private;
+	int bank, source, band;
+
+	seq_printf(m, "radio %pM idx %d active_bank %u\n",
+		   data->addresses[1].addr, data->idx,
+		   READ_ONCE(kernel_medium_bank) & 1);
+	seq_printf(m, "default signal %d loss_pct %u cutoff %d\n",
+		   READ_ONCE(data->rx_rssi),
+		   min(READ_ONCE(kernel_medium_loss_pct), 100U),
+		   READ_ONCE(kernel_medium_cutoff));
+
+	for (bank = 0; bank < HWSIM_KERNEL_MEDIUM_BANKS; bank++) {
+		for (source = 0;
+		     source < HWSIM_KERNEL_MEDIUM_MAX_RADIOS; source++) {
+			for (band = 0; band < HWSIM_KERNEL_MEDIUM_BANDS;
+			     band++) {
+				struct hwsim_kernel_medium_link *link =
+					&data->kernel_medium_links[bank][source][band];
+
+				if (!smp_load_acquire(&link->valid))
+					continue;
+				seq_printf(m, "set %d %pM %s %d %u\n", bank,
+					   link->source,
+					   hwsim_kernel_medium_band_names[band],
+					   READ_ONCE(link->signal),
+					   READ_ONCE(link->loss_pct));
+			}
+		}
+	}
+
+	seq_printf(m, "stats considered %llu delivered %llu dropped %llu\n",
+		   data->kernel_medium_considered,
+		   data->kernel_medium_delivered,
+		   data->kernel_medium_dropped);
+	return 0;
+}
+
+static int hwsim_kernel_medium_links_open(struct inode *inode,
+					  struct file *file)
+{
+	return single_open(file, hwsim_kernel_medium_links_show,
+			   inode->i_private);
+}
+
+static ssize_t hwsim_kernel_medium_links_write(struct file *file,
+					       const char __user *userbuf,
+					       size_t count, loff_t *ppos)
+{
+	struct seq_file *seq = file->private_data;
+	struct mac80211_hwsim_data *receiver = seq->private;
+	struct mac80211_hwsim_data *source;
+	struct hwsim_kernel_medium_link *link;
+	char buf[96], command[16], mac_text[18], band_text[8];
+	u8 source_addr[ETH_ALEN];
+	unsigned int bank, loss;
+	int signal, band, source_idx = -1;
+
+	if (!count || count >= sizeof(buf))
+		return -EINVAL;
+	if (copy_from_user(buf, userbuf, count))
+		return -EFAULT;
+	buf[count] = '\0';
+
+	if (sscanf(buf, "%15s %u", command, &bank) == 2 &&
+	    !strcmp(command, "clear-bank")) {
+		if (bank >= HWSIM_KERNEL_MEDIUM_BANKS)
+			return -ERANGE;
+		for (source_idx = 0;
+		     source_idx < HWSIM_KERNEL_MEDIUM_MAX_RADIOS; source_idx++) {
+			for (band = 0; band < HWSIM_KERNEL_MEDIUM_BANDS; band++)
+				smp_store_release(&receiver->kernel_medium_links[bank]
+								[source_idx][band].valid,
+						  0);
+		}
+		return count;
+	}
+
+	if (sscanf(buf, "%15s %u %17s %7s %d %u", command, &bank,
+		   mac_text, band_text, &signal, &loss) != 6 ||
+	    strcmp(command, "set"))
+		return -EINVAL;
+	if (bank >= HWSIM_KERNEL_MEDIUM_BANKS || loss > 100 ||
+	    signal >= 0 || signal < -127)
+		return -ERANGE;
+	band = hwsim_kernel_medium_band_slot(band_text);
+	if (band < 0 || !mac_pton(mac_text, source_addr))
+		return -EINVAL;
+
+	spin_lock_bh(&hwsim_radio_lock);
+	list_for_each_entry(source, &hwsim_radios, list) {
+		if (ether_addr_equal(source->addresses[1].addr, source_addr)) {
+			source_idx = source->idx;
+			break;
+		}
+	}
+	if (source_idx < 0 || source_idx >= HWSIM_KERNEL_MEDIUM_MAX_RADIOS) {
+		spin_unlock_bh(&hwsim_radio_lock);
+		return -ENOENT;
+	}
+
+	link = &receiver->kernel_medium_links[bank][source_idx][band];
+	smp_store_release(&link->valid, 0);
+	ether_addr_copy(link->source, source_addr);
+	WRITE_ONCE(link->signal, signal);
+	WRITE_ONCE(link->loss_pct, loss);
+	smp_store_release(&link->valid, 1);
+	spin_unlock_bh(&hwsim_radio_lock);
+
+	return count;
+}
+
+static const struct file_operations hwsim_kernel_medium_links_fops = {
+	.owner = THIS_MODULE,
+	.open = hwsim_kernel_medium_links_open,
+	.read = seq_read,
+	.write = hwsim_kernel_medium_links_write,
+	.llseek = seq_lseek,
+	.release = single_release,
+};
