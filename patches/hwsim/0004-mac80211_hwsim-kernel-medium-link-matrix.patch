+#define HWSIM_KERNEL_MEDIUM_BANKS 2
+#define HWSIM_KERNEL_MEDIUM_MAX_RADIOS 128
+#define HWSIM_KERNEL_MEDIUM_BANDS 3
+
+struct hwsim_kernel_medium_link {
+	u8 source[ETH_ALEN];
+	s8 signal;
+	u8 loss_pct;
+	u8 valid;
+};
