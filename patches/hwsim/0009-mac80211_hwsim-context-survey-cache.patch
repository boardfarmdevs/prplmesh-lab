+static void hwsim_rf_reset(struct mac80211_hwsim_data *data)
+{
+	unsigned long flags;
+	unsigned int slot;
+	spin_lock_irqsave(&data->rf_survey_lock, flags);
+	for (slot = 0; slot < HWSIM_RF_CONTEXTS; slot++) {
+		data->rf_contexts[slot].valid = false;
+		data->rf_contexts[slot].epoch = ++data->rf_epoch;
+	}
+	spin_unlock_irqrestore(&data->rf_survey_lock, flags);
+}
+
+static void hwsim_rf_context_update(struct ieee80211_hw *hw,
+				   struct ieee80211_chanctx_conf *context,
+				   int users_delta, bool remove)
+{
+	struct mac80211_hwsim_data *data = hw->priv;
+	struct hwsim_rf_context *record = NULL;
+	unsigned long flags;
+	unsigned int slot;
+	unsigned int width = context->def.width == NL80211_CHAN_WIDTH_20 ||
+		context->def.width == NL80211_CHAN_WIDTH_20_NOHT ? 20 : 0;
+	spin_lock_irqsave(&data->rf_survey_lock, flags);
+	for (slot = 0; slot < HWSIM_RF_CONTEXTS; slot++)
+		if (data->rf_contexts[slot].context == context) {
+			record = &data->rf_contexts[slot];
+			break;
+		}
+	if (!record && !remove)
+		for (slot = 0; slot < HWSIM_RF_CONTEXTS; slot++)
+			if (!data->rf_contexts[slot].context) {
+				record = &data->rf_contexts[slot];
+				break;
+			}
+	if (record) {
+		if (remove) {
+			memset(record, 0, sizeof(*record));
+		} else {
+			if (record->context != context || record->channel != context->def.chan ||
+			    record->width != width || !record->users) {
+				record->epoch = ++data->rf_epoch;
+				record->valid = false;
+			}
+			record->context = context;
+			record->channel = context->def.chan;
+			record->width = width;
+			if (users_delta > 0)
+				record->users++;
+			else if (users_delta < 0 && record->users)
+				record->users--;
+		}
+	}
+	spin_unlock_irqrestore(&data->rf_survey_lock, flags);
+}
+
+static bool hwsim_rf_available(struct mac80211_hwsim_data *data)
+{
+	return READ_ONCE(data->started) && !READ_ONCE(data->scanning) &&
+		!READ_ONCE(data->hw_scan_request) && !READ_ONCE(data->tmp_chan);
+}
+
+static int hwsim_rf_survey_show(struct seq_file *stream, void *unused)
+{
+	struct mac80211_hwsim_data *data = stream->private;
+	struct hwsim_rf_context records[HWSIM_RF_CONTEXTS];
+	unsigned long flags;
+	unsigned int slot;
+	spin_lock_irqsave(&data->rf_survey_lock, flags);
+	memcpy(records, data->rf_contexts, sizeof(records));
+	spin_unlock_irqrestore(&data->rf_survey_lock, flags);
+	seq_printf(stream, "v1 radio %pM available %u\n", data->addresses[1].addr,
+		   hwsim_rf_available(data));
+	for (slot = 0; slot < HWSIM_RF_CONTEXTS; slot++) {
+		struct hwsim_rf_context *record = &records[slot];
+		if (!record->context || !record->users)
+			continue;
+		seq_printf(stream, "%u %llu %u %u %llu %llu %llu %llu %u\n",
+			slot, record->epoch, record->channel->center_freq, record->width,
+			record->provider, record->observed_us, record->active_us,
+			record->busy_us, record->valid);
+	}
+	return 0;
+}
+
+static int hwsim_rf_survey_open(struct inode *inode, struct file *file)
+{
+	return single_open(file, hwsim_rf_survey_show, inode->i_private);
+}
+
+static ssize_t hwsim_rf_survey_write(struct file *file, const char __user *buffer,
+				    size_t length, loff_t *offset)
+{
+	struct mac80211_hwsim_data *data = ((struct seq_file *)file->private_data)->private;
+	struct hwsim_rf_context *record;
+	char text[192], extra;
+	unsigned int slot;
+	unsigned long long epoch, provider, observed, active, busy;
+	unsigned long flags;
+	u64 now = ktime_get_ns() / 1000;
+	int error = 0;
+	if (!length || length >= sizeof(text) || copy_from_user(text, buffer, length))
+		return -EINVAL;
+	text[length] = 0;
+	if (sscanf(text, "v1 %u %llu %llu %llu %llu %llu %c", &slot, &epoch,
+		   &provider, &observed, &active, &busy, &extra) != 6 ||
+	    slot >= HWSIM_RF_CONTEXTS || !provider || busy > active ||
+	    observed > now || now - observed > 1000000 || !hwsim_rf_available(data))
+		return -EINVAL;
+	spin_lock_irqsave(&data->rf_survey_lock, flags);
+	record = &data->rf_contexts[slot];
+	if (!record->context || !record->users || record->epoch != epoch || record->width != 20)
+		error = -ESTALE;
+	else if (record->valid && record->provider == provider &&
+		 (observed <= record->observed_us || active < record->active_us || busy < record->busy_us))
+		error = -ERANGE;
+	else {
+		record->provider = provider;
+		record->observed_us = observed;
+		record->active_us = active;
+		record->busy_us = busy;
+		record->valid = active > 0;
+	}
+	spin_unlock_irqrestore(&data->rf_survey_lock, flags);
+	return error ? error : length;
+}
+
+static const struct file_operations hwsim_rf_survey_fops = {
+	.open = hwsim_rf_survey_open,
+	.read = seq_read,
+	.write = hwsim_rf_survey_write,
+	.llseek = seq_lseek,
+	.release = single_release,
+	.owner = THIS_MODULE,
+};
+
+static int hwsim_rf_get_survey(struct mac80211_hwsim_data *data, int index,
+			     struct survey_info *survey)
+{
+	unsigned long flags;
+	unsigned int slot, found = 0;
+	u64 now = ktime_get_ns() / 1000;
+	int result = -ENOENT;
+	if (index < 0 || !hwsim_rf_available(data))
+		return -ENOENT;
+	spin_lock_irqsave(&data->rf_survey_lock, flags);
+	for (slot = 0; slot < HWSIM_RF_CONTEXTS; slot++) {
+		struct hwsim_rf_context *record = &data->rf_contexts[slot];
+		if (!record->context || !record->users || !record->valid ||
+		    record->width != 20 || now - record->observed_us > 1000000)
+			continue;
+		if (found++ != index)
+			continue;
+		survey->channel = record->channel;
+		survey->filled = SURVEY_INFO_IN_USE | SURVEY_INFO_TIME | SURVEY_INFO_TIME_BUSY;
+		survey->time = record->active_us / 1000;
+		survey->time_busy = record->busy_us / 1000;
+		result = 0;
+		break;
+	}
+	spin_unlock_irqrestore(&data->rf_survey_lock, flags);
+	return result;
+}
