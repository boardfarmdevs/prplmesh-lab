+static unsigned int
+hwsim_kernel_medium_rate_kbps(struct mac80211_hwsim_data *source,
+			      const struct ieee80211_rx_status *status)
+{
+	static const unsigned int ht20_kbps[] = {
+		6500, 13000, 19500, 26000, 39000, 52000, 58500, 65000,
+	};
+	static const unsigned int vht20_kbps[] = {
+		6500, 13000, 19500, 26000, 39000,
+		52000, 58500, 65000, 78000, 86700,
+	};
+	struct ieee80211_supported_band *sband;
+	unsigned int rate, width = 1, nss = 1;
+	int idx = status->rate_idx;
+
+	if (status->encoding == RX_ENC_HT) {
+		nss = idx / 8 + 1;
+		rate = ht20_kbps[idx % 8] * nss;
+	} else if (status->encoding == RX_ENC_VHT) {
+		idx = clamp(idx, 0, (int)ARRAY_SIZE(vht20_kbps) - 1);
+		nss = status->nss ? status->nss : 1;
+		rate = vht20_kbps[idx] * nss;
+	} else {
+		sband = source->hw->wiphy->bands[status->band];
+		if (sband && idx >= 0 && idx < sband->n_bitrates)
+			return max(sband->bitrates[idx].bitrate * 100U, 1000U);
+		return 1000;
+	}
+
+	switch (status->bw) {
+	case RATE_INFO_BW_40:
+		width = 2;
+		break;
+	case RATE_INFO_BW_80:
+		width = 4;
+		break;
+	case RATE_INFO_BW_160:
+		width = 8;
+		break;
+	default:
+		break;
+	}
+	rate *= width;
+	if (status->enc_flags & RX_ENC_FLAG_SHORT_GI)
+		rate = rate * 10 / 9;
+	return max(rate, 1000U);
+}
+
+static unsigned int
+hwsim_kernel_medium_airtime_us(struct mac80211_hwsim_data *source,
+			       const struct ieee80211_rx_status *status,
+			       unsigned int frame_len)
+{
+	unsigned int rate_kbps = hwsim_kernel_medium_rate_kbps(source, status);
+
+	/* A reproducible accounting approximation: preamble plus payload time. */
+	return 20 + DIV_ROUND_UP_ULL((u64)frame_len * 8 * 1000, rate_kbps);
+}
