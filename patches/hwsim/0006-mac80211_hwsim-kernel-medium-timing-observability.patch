+static u64
+hwsim_kernel_medium_delay_head_due(struct mac80211_hwsim_data *data)
+{
+	struct sk_buff *skb;
+	unsigned long flags;
+	u64 due_ns = 0;
+
+	spin_lock_irqsave(&data->kernel_medium_delay_queue.lock, flags);
+	skb = skb_peek(&data->kernel_medium_delay_queue);
+	if (skb)
+		due_ns = ktime_to_ns(skb->tstamp);
+	spin_unlock_irqrestore(&data->kernel_medium_delay_queue.lock, flags);
+	return due_ns;
+}
+
+static enum hrtimer_restart
+hwsim_kernel_medium_delay_timer(struct hrtimer *timer)
+{
+	struct mac80211_hwsim_data *data = container_of(timer,
+		struct mac80211_hwsim_data, kernel_medium_delay_timer);
+	struct ieee80211_rx_status status;
+	struct sk_buff *skb;
+	u64 due_ns, now_ns;
+
+	while (!READ_ONCE(data->kernel_medium_shutting_down)) {
+		due_ns = hwsim_kernel_medium_delay_head_due(data);
+		if (!due_ns)
+			return HRTIMER_NORESTART;
+		now_ns = ktime_get_ns();
+		if (due_ns > now_ns) {
+			hrtimer_set_expires(timer, ns_to_ktime(due_ns));
+			return HRTIMER_RESTART;
+		}
+
+		skb = skb_dequeue(&data->kernel_medium_delay_queue);
+		if (!skb)
+			continue;
+		memcpy(&status, IEEE80211_SKB_RXCB(skb), sizeof(status));
+		skb->tstamp = 0;
+		mac80211_hwsim_rx(data, &status, skb);
+		data->kernel_medium_delivered++;
+		data->kernel_medium_delayed_delivered++;
+	}
+	return HRTIMER_NORESTART;
+}
