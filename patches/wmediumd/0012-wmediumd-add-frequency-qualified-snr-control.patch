+static int frequency_override_slot(struct wmediumd *ctx, int source,
+				   int destination, uint32_t frequency_mhz)
+{
+	size_t i;
+
+	for (i = 0; i < ctx->frequency_override_capacity; i++) {
+		struct wmd_frequency_override *entry = &ctx->frequency_overrides[i];
+
+		if (entry->active && entry->source == source &&
+		    entry->destination == destination &&
+		    entry->frequency_mhz == frequency_mhz)
+			return i;
+	}
+	return -1;
+}
+
+int wmd_get_link_snr(struct wmediumd *ctx, struct station *sender,
+		     struct station *receiver, uint32_t frequency_mhz)
+{
+	int slot = frequency_override_slot(ctx, sender->index, receiver->index,
+					   frequency_mhz);
+
+	if (slot >= 0)
+		return ctx->frequency_overrides[slot].snr_db;
+	return ctx->get_link_snr(ctx, sender, receiver);
+}
