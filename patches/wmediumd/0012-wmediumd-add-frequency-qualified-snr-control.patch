+static int handle_frequency_apply(struct wmd_control_client *client,
+				  const struct wmdc_header *request,
+				  const uint8_t *payload, uint32_t payload_len)
+{
+	struct wmediumd *ctx = client->ctx;
+	struct resolved_frequency_update *resolved;
+	uint64_t generation = be64toh(request->generation);
+	uint32_t count, i;
+	int status;
+
+	if (!payload_len || payload_len % sizeof(struct wmdc_frequency_link))
+		return send_response(client->loop.fd, WMDC_OP_APPLY_FREQUENCY,
+			WMDC_ERR_LENGTH, ctx->control_generation, NULL, 0);
+	count = payload_len / sizeof(struct wmdc_frequency_link);
+	if (!ctx->frequency_overrides ||
+	    count > ctx->frequency_override_capacity)
+		return send_response(client->loop.fd, WMDC_OP_APPLY_FREQUENCY,
+			WMDC_ERR_LENGTH, ctx->control_generation, NULL, 0);
+	if (generation != ctx->control_generation + 1)
+		return send_response(client->loop.fd, WMDC_OP_APPLY_FREQUENCY,
+			WMDC_ERR_GENERATION, ctx->control_generation, NULL, 0);
+	resolved = calloc(count, sizeof(*resolved));
+	if (!resolved)
+		return send_response(client->loop.fd, WMDC_OP_APPLY_FREQUENCY,
+			WMDC_ERR_INTERNAL, ctx->control_generation, NULL, 0);
+	status = resolve_frequency_links(ctx, payload, count, resolved);
+	if (status != WMDC_OK) {
+		free(resolved);
+		return send_response(client->loop.fd, WMDC_OP_APPLY_FREQUENCY,
+			status, ctx->control_generation, NULL, 0);
+	}
+	/* Every identity, value and slot has been resolved before mutation. */
+	for (i = 0; i < count; i++) {
+		if (!resolved[i].override) {
+			if (resolved[i].slot >= 0)
+				memset(&ctx->frequency_overrides[resolved[i].slot], 0,
+				       sizeof(ctx->frequency_overrides[resolved[i].slot]));
+			continue;
+		}
+		ctx->frequency_overrides[resolved[i].slot] =
+			(struct wmd_frequency_override) {
+				.source = resolved[i].source,
+				.destination = resolved[i].destination,
+				.frequency_mhz = resolved[i].frequency_mhz,
+				.snr_db = resolved[i].snr_db,
+				.active = true,
+			};
+	}
+	ctx->control_generation = generation;
+	free(resolved);
+	return send_response(client->loop.fd, WMDC_OP_APPLY_FREQUENCY, WMDC_OK,
+			generation, payload, payload_len);
+}
+
+static int handle_frequency_get(struct wmd_control_client *client,
+				const uint8_t *payload, uint32_t payload_len)
+{
+	struct wmediumd *ctx = client->ctx;
+	struct resolved_frequency_update resolved;
+	struct wmdc_frequency_link response;
+	int slot, status, value;
+
+	if (payload_len != sizeof(response))
+		return send_response(client->loop.fd, WMDC_OP_GET_FREQUENCY,
+			WMDC_ERR_LENGTH, ctx->control_generation, NULL, 0);
+	status = resolve_frequency_links(ctx, payload, 1, &resolved);
+	if (status != WMDC_OK)
+		return send_response(client->loop.fd, WMDC_OP_GET_FREQUENCY,
+			status, ctx->control_generation, NULL, 0);
+	slot = frequency_override_slot(ctx, resolved.source, resolved.destination,
+				       resolved.frequency_mhz);
+	value = slot >= 0 ? ctx->frequency_overrides[slot].snr_db :
+		ctx->snr_matrix[resolved.source * ctx->num_stas + resolved.destination];
+	memcpy(&response, payload, sizeof(response));
+	response.snr_db = htobe16((uint16_t)value);
+	response.flags = htobe16(slot >= 0 ? WMDC_FREQUENCY_OVERRIDE : 0);
+	return send_response(client->loop.fd, WMDC_OP_GET_FREQUENCY, WMDC_OK,
+			ctx->control_generation, &response, sizeof(response));
+}
+
+static int handle_frequency_dump(struct wmd_control_client *client)
+{
+	struct wmediumd *ctx = client->ctx;
+	struct wmdc_frequency_link *links;
+	uint32_t count = 0;
+	size_t i;
+	int result;
+
+	links = calloc(ctx->frequency_override_capacity, sizeof(*links));
+	if (!links)
+		return send_response(client->loop.fd, WMDC_OP_DUMP_FREQUENCIES,
+			WMDC_ERR_INTERNAL, ctx->control_generation, NULL, 0);
+	for (i = 0; i < ctx->frequency_override_capacity; i++) {
+		struct wmd_frequency_override *entry = &ctx->frequency_overrides[i];
+
+		if (!entry->active)
+			continue;
+		memcpy(links[count].source, ctx->sta_array[entry->source]->addr, 6);
+		memcpy(links[count].destination,
+		       ctx->sta_array[entry->destination]->addr, 6);
+		links[count].frequency_mhz = htobe32(entry->frequency_mhz);
+		links[count].snr_db = htobe16((uint16_t)entry->snr_db);
+		links[count].flags = htobe16(WMDC_FREQUENCY_OVERRIDE);
+		count++;
+	}
+	result = send_response(client->loop.fd, WMDC_OP_DUMP_FREQUENCIES,
+			       WMDC_OK, ctx->control_generation, links,
+			       count * sizeof(*links));
+	free(links);
+	return result;
+}
