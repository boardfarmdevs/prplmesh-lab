+static bool slot_is_planned(const struct resolved_frequency_update *resolved,
+			    uint32_t count, int slot)
+{
+	uint32_t i;
+
+	for (i = 0; i < count; i++)
+		if (resolved[i].override && resolved[i].slot == slot)
+			return true;
+	return false;
+}
+
+static int resolve_frequency_links(struct wmediumd *ctx, const uint8_t *payload,
+				   uint32_t count,
+				   struct resolved_frequency_update *resolved)
+{
+	const struct wmdc_frequency_link *links =
+		(const struct wmdc_frequency_link *)payload;
+	uint32_t i, j;
+
+	if (!ctx->frequency_overrides)
+		return WMDC_ERR_INTERNAL;
+	for (i = 0; i < count; i++) {
+		uint16_t flags = be16toh(links[i].flags);
+		int slot;
+
+		resolved[i].source = station_index(ctx, links[i].source);
+		resolved[i].destination = station_index(ctx, links[i].destination);
+		resolved[i].frequency_mhz = be32toh(links[i].frequency_mhz);
+		resolved[i].snr_db = (int16_t)be16toh((uint16_t)links[i].snr_db);
+		resolved[i].override = flags & WMDC_FREQUENCY_OVERRIDE;
+		if (resolved[i].source < 0 || resolved[i].destination < 0 ||
+		    resolved[i].source == resolved[i].destination)
+			return WMDC_ERR_IDENTITY;
+		if (flags & ~WMDC_FREQUENCY_OVERRIDE)
+			return WMDC_ERR_VALUE;
+		if (resolved[i].frequency_mhz < WMDC_FREQUENCY_MIN_MHZ ||
+		    resolved[i].frequency_mhz > WMDC_FREQUENCY_MAX_MHZ)
+			return WMDC_ERR_FREQUENCY;
+		if (resolved[i].override &&
+		    (resolved[i].snr_db < -20 || resolved[i].snr_db > 60))
+			return WMDC_ERR_VALUE;
+		for (j = 0; j < i; j++)
+			if (resolved[j].source == resolved[i].source &&
+			    resolved[j].destination == resolved[i].destination &&
+			    resolved[j].frequency_mhz == resolved[i].frequency_mhz)
+				return WMDC_ERR_VALUE;
+
+		slot = frequency_override_slot(ctx, resolved[i].source,
+			resolved[i].destination, resolved[i].frequency_mhz);
+		if (resolved[i].override && slot < 0) {
+			size_t candidate;
+
+			for (candidate = 0;
+			     candidate < ctx->frequency_override_capacity; candidate++)
+				if (!ctx->frequency_overrides[candidate].active &&
+				    !slot_is_planned(resolved, i, candidate)) {
+					slot = candidate;
+					break;
+				}
+			if (slot < 0)
+				return WMDC_ERR_INTERNAL;
+		}
+		resolved[i].slot = slot;
+	}
+	return WMDC_OK;
+}
