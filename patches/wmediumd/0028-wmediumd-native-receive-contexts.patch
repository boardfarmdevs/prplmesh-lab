Subject: [PATCH] wmediumd: consume native receive-channel context snapshots

Use bounded kernel-origin radio contexts rather than the last transmitted
frequency when available. Passive scans do not transmit probe requests.
Keep TX-learned VIF ownership and legacy-kernel behavior separate. Reject
malformed and stale updates; an empty context disables all reception.

Upstream-Status: Inappropriate [experimental paired laboratory protocol]

--- a/wmediumd/wmediumd.h
+++ b/wmediumd/wmediumd.h
@@ -105,10 +105,14 @@
 	HWSIM_ATTR_FREQ,
 	HWSIM_ATTR_PAD,
 	HWSIM_ATTR_TX_INFO_FLAGS,
+	HWSIM_ATTR_RX_CONTEXT = 255,
 	__HWSIM_ATTR_MAX,
 };
 #define HWSIM_ATTR_MAX (__HWSIM_ATTR_MAX - 1)
 
+#define HWSIM_CMD_REPORT_RX_CONTEXT 128
+#define HWSIM_RX_FREQUENCIES 10
+
 #define VERSION_NR 1
 
 #define SNR_DEFAULT 30
@@ -126,6 +130,12 @@
 typedef uint32_t u32;
 typedef uint64_t u64;
 
+struct hwsim_rx_context_report {
+	u64 sequence;
+	u32 version, count;
+	u32 frequencies[HWSIM_RX_FREQUENCIES];
+};
+
 #define TIME_FMT "%lld.%06lld"
 #define TIME_ARGS(a) ((unsigned long long)(a)->tv_sec), ((unsigned long long)(a)->tv_nsec/1000)
 
@@ -163,6 +173,9 @@
 	struct client *client;
 	unsigned int n_addrs;
 	struct addr *addrs;
+	uint64_t rx_context_sequence;
+	unsigned int rx_frequency_count;
