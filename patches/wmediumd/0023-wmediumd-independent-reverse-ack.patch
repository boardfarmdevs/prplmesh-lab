+static int packet_test_fading(struct wmediumd *ctx)
+{
+	return 0;
+}
+
+static double packet_test_per(struct wmediumd *ctx, double snr, unsigned int rate,
+			     u32 frequency, int length, struct station *source,
+			     struct station *destination)
+{
+	return snr < 5 ? 1 : 0;
+}
