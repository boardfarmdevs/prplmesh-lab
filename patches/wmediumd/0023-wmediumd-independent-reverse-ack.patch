+static int packet_path_selftest(void)
+{
+	int failures = 0;
+	for (int scenario = 0; scenario < 3; scenario++) {
+		struct wmediumd test = {0};
+		struct station stations[2] = {0};
+		struct station *pointers[] = {&stations[0], &stations[1]};
+		int matrix[] = {0, 40, scenario == 1 ? -20 : 40, 0};
+		struct frame *frame = calloc(1, sizeof(*frame) + 24);
+		struct ieee80211_hdr *header = (void *)frame->data;
+		INIT_LIST_HEAD(&test.stations);
+		test.sta_array = pointers;
+		test.num_stas = 2;
+		test.snr_matrix = matrix;
+		test.get_link_snr = selftest_pair_snr;
+		test.get_error_prob = packet_test_per;
+		test.get_fading_signal = packet_test_fading;
+		for (int index = 0; index < 2; index++) {
+			stations[index].index = index;
+			stations[index].addr[0] = 0x02;
+			stations[index].addr[1] = 0xee;
+			stations[index].addr[5] = index;
+			station_init_queues(&stations[index]);
+			list_add_tail(&stations[index].list, &test.stations);
+			mc_update_vif_owner(&test, &stations[index], stations[index].addr,
+				 scenario == 2 && index == 1 ? 2437 : 5180);
+		}
+		frame->sender = &stations[0];
+		frame->freq = 5180;
+		frame->data_len = 24;
+		frame->tx_rates_count = 1;
+		frame->tx_rates[0].idx = 7;
+		frame->tx_rates[0].count = 3;
+		header->frame_control[0] = 0x08;
+		memcpy(header->addr1, stations[1].addr, ETH_ALEN);
+		memcpy(header->addr2, stations[0].addr, ETH_ALEN);
+		queue_frame(&test, &stations[0], frame);
+		failures += !!(frame->flags & HWSIM_TX_STAT_ACK) != (scenario == 0);
+		failures += frame->forward_received != (scenario != 2);
+		failures += frame->rx_rate_idx != 7;
+		failures += frame->tx_rates[0].count != (scenario == 0 ? 1 : 3);
+		failures += frame->duration <= 0;
+		list_del(&frame->list);
+		usfstl_sched_del_job(&frame->job);
+		free(frame);
+	}
+	printf("%s actual frame queue: RX rate, ACK success, reverse-only loss and off-channel retries\n",
+		failures ? "FAIL" : "PASS");
+	return failures;
+}
