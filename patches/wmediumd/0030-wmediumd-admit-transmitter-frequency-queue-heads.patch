+		return;
+	frame->queue_accounted = true;
+	frame->queued_at = scheduler.current_time;
+	if (ctx->telemetry) {
+		ctx->telemetry->queue_depth++;
+		if (ctx->telemetry->queue_depth > ctx->telemetry->queue_depth_max)
+			ctx->telemetry->queue_depth_max = ctx->telemetry->queue_depth;
+	}
