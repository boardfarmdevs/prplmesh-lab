+static void schedule_next_radio_frame(struct wmediumd *ctx, struct radio_queue *radio)
+{
+	struct frame *frame;
+	if (radio->active_frame)
+		return;
+	if (list_empty(&radio->pending_frames)) {
+		list_del(&radio->list);
+		free(radio);
+		return;
+	}
+	frame = list_first_entry(&radio->pending_frames, struct frame, list);
+	list_del(&frame->list);
+	radio->active_frame = frame;
+	queue_frame(ctx, frame->sender, frame);
+}
+
+static void enqueue_radio_frame(struct wmediumd *ctx, struct station *station,
+				struct frame *frame)
+{
+	struct radio_queue *radio;
+	frame->radio_queue = NULL;
+	frame->src = station->client;
+	list_for_each_entry(radio, &station->radio_queues, list) {
+		if (radio->frequency == frame->freq) {
+			frame->radio_queue = radio;
+			break;
+		}
+	}
+	if (!frame->radio_queue) {
+		radio = calloc(1, sizeof(*radio));
+		if (!radio) {
+			frame->flags &= ~HWSIM_TX_STAT_ACK;
+			send_tx_info_frame_nl(ctx, frame);
+			free(frame);
+			return;
+		}
+		radio->frequency = frame->freq;
+		INIT_LIST_HEAD(&radio->pending_frames);
+		list_add_tail(&radio->list, &station->radio_queues);
+		frame->radio_queue = radio;
+	}
+	wmd_telemetry_frame_queued(ctx, frame);
+	list_add_tail(&frame->list, &radio->pending_frames);
+	schedule_next_radio_frame(ctx, radio);
+}
