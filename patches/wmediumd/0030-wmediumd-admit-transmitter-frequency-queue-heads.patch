+static void packet_test_complete_radio(struct wmediumd *ctx, struct radio_queue *radio)
+{
+	struct frame *frame = radio->active_frame;
+	rf_release_frame(frame);
+	list_del(&frame->list);
+	usfstl_sched_del_job(&frame->job);
+	usfstl_sched_del_job(&frame->start_job);
+	wmd_telemetry_frame_done(ctx);
+	radio->active_frame = NULL;
+	free(frame);
+	schedule_next_radio_frame(ctx, radio);
+}
