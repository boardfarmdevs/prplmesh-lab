+static int radio_head_selftest(bool visibility)
+{
+	struct wmediumd test = {0};
+	struct station stations[3] = {0};
+	struct station *pointers[3];
+	struct client client = {0};
+	struct client replacement = {0};
+	struct frame *replacement_frame;
+	struct frame *frames[36];
+	struct radio_queue *primary_radio;
+	u8 other_band[ETH_ALEN] = {0x02, 0xdd, 0, 0, 1, 2};
+	int matrix[9];
+	int failures = 0;
+	INIT_LIST_HEAD(&test.stations);
+	INIT_LIST_HEAD(&test.clients_to_free);
+	INIT_LIST_HEAD(&client.list);
+	INIT_LIST_HEAD(&replacement.list);
+	test.sta_array = pointers;
+	test.num_stas = 3;
+	test.snr_matrix = matrix;
+	test.get_link_snr = selftest_pair_snr;
+	test.get_error_prob = packet_test_per;
+	test.get_fading_signal = packet_test_fading;
+	test.visibility_contention = visibility;
+	test.survey_disabled = true;
+	test.need_start_notify = 1;
+	for (int index = 0; index < 9; index++)
+		matrix[index] = 40;
+	for (int index = 0; index < 3; index++) {
+		pointers[index] = &stations[index];
+		stations[index].index = index;
+		stations[index].client = &client;
+		stations[index].addr[0] = 0x02;
+		stations[index].addr[1] = 0xdd;
+		stations[index].addr[5] = index;
+		station_init_queues(&stations[index]);
+		list_add_tail(&stations[index].list, &test.stations);
+		mc_update_vif_owner(&test, &stations[index], stations[index].addr, 5180);
+	}
+	mc_update_vif_owner(&test, &stations[2], other_band, 5200);
+	for (int index = 0; index < 36; index++) {
+		struct frame *frame = calloc(1, sizeof(*frame) + 1000);
+		struct ieee80211_hdr *header = (void *)frame->data;
+		frames[index] = frame;
+		frame->sender = &stations[index == 32 ? 1 : 0];
+		frame->freq = index >= 34 ? 5200 : 5180;
+		frame->data_len = 1000;
+		frame->tx_rates_count = 1;
+		frame->tx_rates[0].idx = 7;
+		frame->tx_rates[0].count = 3;
+		header->frame_control[0] = index == 33 ? 0xb0 : 0x08;
+		memcpy(header->addr1, index >= 34 ? other_band : stations[2].addr, ETH_ALEN);
+		memcpy(header->addr2, frame->sender->addr, ETH_ALEN);
+		enqueue_radio_frame(&test, frame->sender, frame);
+	}
+	replacement_frame = calloc(1, sizeof(*replacement_frame) + 1000);
+	replacement_frame->sender = &stations[0];
+	replacement_frame->freq = 5180;
+	replacement_frame->data_len = 1000;
+	replacement_frame->tx_rates_count = 1;
+	replacement_frame->tx_rates[0].idx = 7;
+	replacement_frame->tx_rates[0].count = 3;
+	struct ieee80211_hdr *replacement_header = (void *)replacement_frame->data;
+	replacement_header->frame_control[0] = 0x08;
+	memcpy(replacement_header->addr1, stations[2].addr, ETH_ALEN);
+	memcpy(replacement_header->addr2, stations[0].addr, ETH_ALEN);
+	stations[0].client = &replacement;
+	enqueue_radio_frame(&test, &stations[0], replacement_frame);
+	stations[0].client = &client;
+	primary_radio = frames[0]->radio_queue;
+	failures += primary_radio->active_frame != frames[0];
+	failures += frames[32]->radio_queue->active_frame != frames[32];
+	failures += frames[34]->radio_queue == primary_radio;
+	failures += frames[34]->radio_queue->active_frame != frames[34];
+	failures += frames[34]->job.start != scheduler.current_time + frames[34]->duration;
+	failures += !(frames[34]->flags & HWSIM_TX_STAT_ACK);
+	failures += frames[35]->job.callback != NULL;
+	failures += frames[1]->job.callback != NULL || frames[33]->job.callback != NULL;
+	failures += frames[32]->job.start > frames[0]->job.start + frames[32]->duration;
+	printf("radio peer reservation: first=%llu us, peer=%llu us, backlog=32 frames\n",
+		(unsigned long long)(frames[0]->job.start - scheduler.current_time),
+		(unsigned long long)(frames[32]->job.start - scheduler.current_time));
+	if (failures)
+		goto cleanup;
+	mc_update_vif_owner(&test, &stations[2], stations[2].addr, 2437);
+	packet_test_complete_radio(&test, primary_radio);
+	failures += primary_radio->active_frame != frames[1];
+	failures += !!(frames[1]->flags & HWSIM_TX_STAT_ACK) || frames[1]->forward_received;
+	failures += frames[1]->tx_rates[0].count != 3;
+	if (failures)
+		goto cleanup;
+	mc_update_vif_owner(&test, &stations[2], stations[2].addr, 5180);
+	packet_test_complete_radio(&test, frames[34]->radio_queue);
+	failures += frames[35]->radio_queue->active_frame != frames[35];
+	failures += !(frames[35]->flags & HWSIM_TX_STAT_ACK);
+	packet_test_complete_radio(&test, frames[35]->radio_queue);
+	packet_test_complete_radio(&test, primary_radio);
+	for (int index = 2; index < 16; index++) {
+		failures += primary_radio->active_frame != frames[index];
+		if (failures)
+			goto cleanup;
+		packet_test_complete_radio(&test, primary_radio);
+	}
+cleanup:
+	wmediumd_remove_client(&test, &client);
+	failures += replacement_frame->src != &replacement;
+	failures += replacement_frame->radio_queue->active_frame != replacement_frame;
+	failures += stations[0].client != NULL;
+	wmediumd_remove_client(&test, &replacement);
+	failures += !usfstl_list_empty(&scheduler.joblist);
+	failures += !usfstl_list_empty(&scheduler.pending_jobs);
+	for (int index = 0; index < 3; index++) {
+		failures += !list_empty(&stations[index].radio_queues);
+		for (int category = 0; category < IEEE80211_NUM_ACS; category++) {
+			failures += !list_empty(&stations[index].queues[category].frames);
+		}
+	}
+	printf("%s radio head admission (%s): bounded peer reservation, per-frequency concurrency, kernel-order FIFO across access categories, deferred receive eligibility and pending-client ownership/removal\n",
+		failures ? "FAIL" : "PASS", visibility ? "visibility" : "global");
+	return failures;
+}
