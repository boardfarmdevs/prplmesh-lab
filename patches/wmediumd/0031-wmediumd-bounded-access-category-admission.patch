+	unsigned int priority_burst;
 	struct frame *active_frame;
 	u32 frequency;
 };
@@ -261,6 +263,7 @@ struct wmediumd {
 	u64 control_generation;
 	struct wmd_airtime airtime;
 	bool visibility_contention;
