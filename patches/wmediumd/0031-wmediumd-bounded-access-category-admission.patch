 	size_t frequency_override_capacity;
@@ -305,6 +308,7 @@ struct frame {
 	uint64_t queued_at;
 	bool queue_accounted;
 	struct radio_queue *radio_queue;
+	struct list_head ac_pending;
 	struct client *src;
 	bool acked;
 	u64 cookie;
