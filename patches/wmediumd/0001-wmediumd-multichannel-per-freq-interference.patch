+static int wmd_selftest(void)
+{
+	int fails = 0, i, j;
+	unsigned long sf, cf;
+	struct wmediumd t = {};
+
+	printf("=== wmediumd WMD3 (freq-scoped interference) + WMD1v2 (ownership) self-test ===\n");
+
+	/* ---------- WMD3: frequency-scoped interference ---------- */
+	t.num_stas = 4;
+	t.intf = calloc(t.num_stas * t.num_stas, sizeof(struct intf_info));
+
+	/* interferer station 2 transmits on 5180; station 3 transmits on 2437 */
+	set_interference_duration(&t, 2, 5180, 10000, -95);
+	set_interference_duration(&t, 3, 2437, 10000, -95);
+	/* convert accumulated duration -> prob_col (same as wmediumd_intf_update) */
+	for (i = 0; i < t.num_stas; i++)
+		for (j = 0; j < t.num_stas; j++) {
+			struct intf_info *cell = &t.intf[i * t.num_stas + j];
+			int k;
+			if (i == j)
+				continue;
+			for (k = 0; k < cell->n_buckets; k++) {
+				cell->buckets[k].prob_col =
+					cell->buckets[k].duration / 10000.0;
+				cell->buckets[k].duration = 0;
+			}
+		}
+
+	sf = intf_samefreq_applied; cf = intf_crossfreq_skipped;
+	get_signal_offset_by_interference(&t, 0, 1, 2437);
+	if (intf_samefreq_applied - sf == 1 && intf_crossfreq_skipped - cf == 1)
+		printf("PASS 2437 victim: +1 samefreq (S3@2437 considered), +1 crossfreq skipped (S2@5180)\n");
+	else { printf("FAIL 2437 victim: dsame=%lu dcross=%lu want 1,1\n",
+		intf_samefreq_applied - sf, intf_crossfreq_skipped - cf); fails++; }
+
+	sf = intf_samefreq_applied; cf = intf_crossfreq_skipped;
+	get_signal_offset_by_interference(&t, 0, 1, 5180);
+	if (intf_samefreq_applied - sf == 1 && intf_crossfreq_skipped - cf == 1)
+		printf("PASS 5180 victim: +1 samefreq (S2@5180 considered), +1 crossfreq skipped (S3@2437)\n");
+	else { printf("FAIL 5180 victim: dsame=%lu dcross=%lu want 1,1\n",
+		intf_samefreq_applied - sf, intf_crossfreq_skipped - cf); fails++; }
+
+	sf = intf_samefreq_applied; cf = intf_crossfreq_skipped;
+	{
+		int off = get_signal_offset_by_interference(&t, 0, 1, 6000);
+		if (intf_samefreq_applied - sf == 0 &&
+		    intf_crossfreq_skipped - cf == 2 && off == 0)
+			printf("PASS isolation: victim@6000 -> 0 applied, 2 cross skipped, offset=0 (no cross-band leak)\n");
+		else { printf("FAIL isolation: dsame=%lu dcross=%lu off=%d want 0,2,0\n",
+			intf_samefreq_applied - sf, intf_crossfreq_skipped - cf, off); fails++; }
+	}
+	free(t.intf);
+
+	/* ---------- WMD1 v2: ownership invariant vs RX-filter churn ---------- */
+	{
+		struct station r3 = {}, apa = {};
+		u8 sta[ETH_ALEN] = {0x02,0,0,0,0,0x03};
+		u32 f = 0;
+		struct mc_vif_state *v;
+		r3.addr[0] = 0x42; r3.addr[5] = 0x03;
+		apa.addr[0] = 0x42; apa.addr[5] = 0x01;
+
+		mc_update_vif_owner(&r3, sta, 2437);
+		mc_update_vif_owner(&r3, sta, 5180);   /* roam on the SAME owning radio */
+		v = mc_vif_find(sta);
+		if (mc_lookup_owned_vif(sta, &f) && f == 5180 && v && v->owner == &r3)
+			printf("PASS ownership: STA owned by its own radio r3 @ 5180 after roam\n");
+		else { printf("FAIL ownership: f=%u\n", f); fails++; }
+
+		/* Simulate what HWSIM_CMD_ADD_MAC_ADDR does: register the STA MAC in
+		 * AP-A's RX filter (station->addrs[]). Ownership must NOT change. */
+		apa.n_addrs = 1;
+		apa.addrs = calloc(1, sizeof(struct addr));
+		memcpy(apa.addrs[0].addr, sta, ETH_ALEN);
+		if (mc_lookup_owned_vif(sta, &f) && f == 5180 && v->owner == &r3)
+			printf("PASS invariant: ADD_MAC_ADDR RX-filter churn does not alter ownership/freq\n");
+		else { printf("FAIL invariant: RX-filter churn changed ownership\n"); fails++; }
+		free(apa.addrs);
+	}
+
+	printf("=== self-test %s (%d failures) ===\n", fails ? "FAILED" : "PASSED", fails);
+	return fails ? 1 : 0;
+}
