+static enum ack_eligibility mc_receiver_ack_eligibility(struct wmediumd *ctx, const u8 *dest, u32 tx_freq)
+{
+	u32 dfreq;
+	(void)ctx;
+	if (!mc_lookup_owned_vif(dest, &dfreq)) return ACK_FREQ_UNKNOWN;
+	if (dfreq != tx_freq) return ACK_OFFCHANNEL;
+	return ACK_ELIGIBLE;
+}
