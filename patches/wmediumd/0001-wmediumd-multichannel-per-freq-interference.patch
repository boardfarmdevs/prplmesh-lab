+/* WMD 1/4 (v2): VIF ownership + active frequency, learned ONLY from transmitted
+ * frames. Ownership = (802.11 TA) belongs to (hwsim radio in ADDR_TRANSMITTER).
+ * Deliberately NOT derived from HWSIM_CMD_ADD_MAC_ADDR, which is a receive-filter
+ * registration: the same client MAC legitimately appears on multiple radios' RX
+ * filters and must not be treated as owned by them. */
+struct mc_vif_state {
+	u8 vif_addr[ETH_ALEN];
+	struct station *owner;
+	u32 freq;
+	int freq_known;
+};
+static struct mc_vif_state *mc_vifs;
+static size_t mc_n_vifs;
+
+static struct mc_vif_state *mc_vif_find(const u8 *mac)
+{
+	size_t i;
+	for (i = 0; i < mc_n_vifs; i++)
+		if (memcmp(mc_vifs[i].vif_addr, mac, ETH_ALEN) == 0)
+			return &mc_vifs[i];
+	return NULL;
+}
+
+static void mc_update_vif_owner(struct station *owner, const u8 *ta, u32 freq)
+{
+	struct mc_vif_state *v = mc_vif_find(ta);
+	if (!v) {
+		struct mc_vif_state *n =
+			realloc(mc_vifs, sizeof(*mc_vifs) * (mc_n_vifs + 1));
+		if (!n)
+			return;
+		mc_vifs = n;
+		v = &mc_vifs[mc_n_vifs++];
+		memcpy(v->vif_addr, ta, ETH_ALEN);
+		v->freq = 0;
+		v->freq_known = 0;
+	}
+	if (!v->freq_known || v->freq != freq || v->owner != owner) {
+		FILE *_f = fopen("/tmp/mc_owner.log", "a");
+		if (_f) {
+			fprintf(_f, "MC-OWNER mac=" MAC_FMT " radio=" MAC_FMT " %u->%u\n",
+				MAC_ARGS(ta), MAC_ARGS(owner->addr),
+				v->freq_known ? v->freq : 0, freq);
+			fclose(_f);
+		}
+	}
+	v->owner = owner;
+	v->freq = freq;
+	v->freq_known = 1;
+}
+
+static int mc_lookup_owned_vif(const u8 *dest, u32 *freq)
+{
+	struct mc_vif_state *v = mc_vif_find(dest);
+	if (v && v->freq_known) {
+		*freq = v->freq;
+		return 1;
+	}
+	return 0;
+}
