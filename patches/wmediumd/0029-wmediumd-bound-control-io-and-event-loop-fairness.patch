+static int control_response_selftest(void)
+{
+	int sockets[2], failures = 0, buffer_size = 4096;
+	char payload[1024] = {};
+	struct wmdc_header header = {};
+	if (socketpair(AF_UNIX, SOCK_SEQPACKET, 0, sockets))
+		return 1;
+	failures += send_response(sockets[0], WMDC_OP_STATUS, WMDC_OK, 42, NULL, 0) != 0;
+	failures += recv(sockets[1], &header, sizeof(header), MSG_DONTWAIT) != sizeof(header);
+	failures += be64toh(header.generation) != 42 || be16toh(header.opcode) != WMDC_OP_STATUS;
+	setsockopt(sockets[0], SOL_SOCKET, SO_SNDBUF, &buffer_size, sizeof(buffer_size));
+	while (send(sockets[0], payload, sizeof(payload), MSG_DONTWAIT | MSG_NOSIGNAL) > 0) {}
+	alarm(2);
+	failures += send_response(sockets[0], WMDC_OP_STATUS, WMDC_OK, 43, NULL, 0) != -1;
+	failures += errno != EAGAIN && errno != EWOULDBLOCK;
+	alarm(0);
+	close(sockets[1]);
+	failures += send_response(sockets[0], WMDC_OP_STATUS, WMDC_OK, 44, NULL, 0) != -1;
+	close(sockets[0]);
+	printf("%s control responses: healthy, stalled and disconnected readers cannot block the medium\n",
+		failures ? "FAIL" : "PASS");
+	return failures;
+}
