+static void usfstl_loop_rotate(struct usfstl_loop_entry *entry)
+{
+	struct usfstl_loop_entry *candidate, *tail = entry;
+	usfstl_loop_for_each_entry(candidate) {
+		if (candidate->priority == entry->priority)
+			tail = candidate;
+	}
+	if (tail != entry) {
+		usfstl_list_item_remove(&entry->list);
+		usfstl_list_insert_before(tail->list.next, &entry->list);
+	}
+}
