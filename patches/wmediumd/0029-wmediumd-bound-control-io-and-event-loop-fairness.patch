+struct loop_test_reader {
+	struct usfstl_loop_entry entry;
+	unsigned int calls;
+	bool remove;
+};
+
+static void loop_test_ready(struct usfstl_loop_entry *entry)
+{
+	struct loop_test_reader *reader = container_of(entry, struct loop_test_reader, entry);
+	reader->calls++;
+	if (reader->remove)
+		usfstl_loop_unregister(entry);
+}
+
+static void loop_test_connected(int descriptor, void *data)
+{
+	(void)data;
+	close(descriptor);
+}
+
+static int event_loop_selftest(void)
+{
+	struct loop_test_reader readers[3] = {};
+	int pipes[3][2], failures = 0;
+	struct usfstl_loop_entry *entry;
+	char directory[] = "/tmp/wmediumd-loop-XXXXXX", path[108];
+	if (!usfstl_list_empty(&g_usfstl_loop_entries))
+		return 1;
+	for (unsigned int index = 0; index < 3; index++) {
+		assert(pipe(pipes[index]) == 0);
+		assert(write(pipes[index][1], "ready", 5) == 5);
+		readers[index].entry.fd = pipes[index][0];
+		readers[index].entry.handler = loop_test_ready;
+		readers[index].entry.priority = index == 0 ? 1 : 0;
+		readers[index].remove = index == 0;
+		usfstl_loop_register(&readers[index].entry);
+	}
+	usfstl_loop_wait_and_handle();
+	failures += readers[0].calls != 1 || readers[1].calls != 0 || readers[2].calls != 0;
+	usfstl_loop_wait_and_handle();
+	usfstl_loop_wait_and_handle();
+	failures += readers[1].calls != 1 || readers[2].calls != 1;
+	readers[1].remove = true;
+	for (unsigned int index = 0; index < 4; index++)
+		usfstl_loop_wait_and_handle();
+	failures += readers[1].entry.list.next != NULL || readers[1].calls != 2;
+	for (unsigned int index = 0; index < 3; index++) {
+		if (readers[index].entry.list.next)
+			usfstl_loop_unregister(&readers[index].entry);
+		close(pipes[index][0]);
+		close(pipes[index][1]);
+	}
+	assert(mkdtemp(directory));
+	snprintf(path, sizeof(path), "%s/control", directory);
+	usfstl_uds_create_seqpacket(path, loop_test_connected, NULL);
+	usfstl_loop_for_each_entry(entry)
+		failures += entry->priority != 0 || entry->data != NULL;
+	usfstl_uds_remove(path);
+	rmdir(directory);
+	printf("%s event loop: priority order, equal-priority fairness, callback removal and initialized listener state\n",
+		failures ? "FAIL" : "PASS");
+	return failures;
+}
