+static uint64_t rf_reservation_start(struct wmediumd *ctx, const struct frame *frame,
+				    uint64_t duration)
+{
+	struct frame *reserved;
+	uint64_t target = scheduler.current_time;
+	if (!ctx->rf_reservations.next)
+		INIT_LIST_HEAD(&ctx->rf_reservations);
+	list_for_each_entry(reserved, &ctx->rf_reservations, rf_reservation) {
+		if (reserved->freq == frame->freq && reserved->sender == frame->sender &&
+		    reserved->job.start > target)
+			target = reserved->job.start;
+	}
+	list_for_each_entry(reserved, &ctx->rf_reservations, rf_reservation) {
+		if (reserved->job.start > target &&
+		    reserved->job.start - reserved->duration < target + duration &&
+		    rf_flows_conflict(ctx, reserved, frame))
+			target = reserved->job.start;
+	}
+	return target;
+}
+
+static void rf_reserve_frame(struct wmediumd *ctx, struct frame *frame)
+{
+	struct frame *reserved;
+	struct list_head *previous = &ctx->rf_reservations;
+	if (!ctx->visibility_contention)
+		return;
+	list_for_each_entry_reverse(reserved, &ctx->rf_reservations, rf_reservation) {
+		if (reserved->job.start <= frame->job.start) {
+			previous = &reserved->rf_reservation;
+			break;
+		}
+	}
+	list_add(&frame->rf_reservation, previous);
+}
+
+static void rf_release_frame(struct frame *frame)
+{
+	if (frame->rf_reservation.next) {
+		list_del(&frame->rf_reservation);
+		frame->rf_reservation.next = NULL;
+	}
+}
