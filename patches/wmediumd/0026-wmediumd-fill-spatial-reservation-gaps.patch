+static int spatial_gap_selftest(void)
+{
+	struct wmediumd test = {0};
+	struct station stations[4] = {0};
+	struct station *pointers[4];
+	struct frame *frames[5];
+	int matrix[16];
+	int failures = 0;
+	INIT_LIST_HEAD(&test.stations);
+	test.sta_array = pointers;
+	test.num_stas = 4;
+	test.snr_matrix = matrix;
+	test.get_link_snr = selftest_pair_snr;
+	test.get_error_prob = packet_test_per;
+	test.get_fading_signal = packet_test_fading;
+	test.visibility_contention = true;
+	for (int index = 0; index < 16; index++)
+		matrix[index] = -20;
+	matrix[1] = matrix[4] = matrix[11] = matrix[14] = 40;
+	for (int index = 0; index < 4; index++) {
+		pointers[index] = &stations[index];
+		stations[index].index = index;
+		stations[index].addr[0] = 0x02;
+		stations[index].addr[1] = 0xed;
+		stations[index].addr[5] = index;
+		station_init_queues(&stations[index]);
+		list_add_tail(&stations[index].list, &test.stations);
+		mc_update_vif_owner(&test, &stations[index], stations[index].addr, 5180);
+	}
+	for (int index = 0; index < 5; index++) {
+		struct frame *frame = calloc(1, sizeof(*frame) + 1500);
+		struct ieee80211_hdr *header = (void *)frame->data;
+		frames[index] = frame;
+		frame->sender = &stations[index < 2 ? index : 2];
+		frame->freq = 5180;
+		frame->data_len = index == 0 || index == 4 ? 1500 : 100;
+		frame->tx_rates_count = 1;
+		frame->tx_rates[0].idx = 7;
+		frame->tx_rates[0].count = 1;
+		header->frame_control[0] = 0x08;
+		memcpy(header->addr1, stations[index == 0 ? 1 : 3].addr, ETH_ALEN);
+		memcpy(header->addr2, frame->sender->addr, ETH_ALEN);
+		if (index == 1)
+			header->addr1[0] = 0xff;
+		queue_frame(&test, frame->sender, frame);
+	}
+	failures += frames[2]->job.start >= frames[0]->job.start;
+	failures += frames[3]->job.start - frames[3]->duration < frames[2]->job.start;
+	failures += frames[4]->job.start - frames[4]->duration < frames[1]->job.start;
+	for (int index = 0; index < 5; index++) {
+		rf_release_frame(frames[index]);
+		list_del(&frames[index]->list);
+		usfstl_sched_del_job(&frames[index]->job);
+		free(frames[index]);
+	}
+	wmd_airtime_free(&test.airtime);
+	printf("%s spatial reservation gaps: fill independent gaps, preserve sender FIFO and multicast exclusion\n",
+		failures ? "FAIL" : "PASS");
+	return failures;
+}
