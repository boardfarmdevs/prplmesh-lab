From: Codex <codex@openai.com>
Subject: [PATCH 5/5] wmediumd: handle Linux 7 HT/VHT transmit-rate flags

Linux 7 supplies HWSIM_ATTR_TX_INFO_FLAGS alongside the transmit-rate
array.  An HT or VHT MCS index is not a legacy hwsim_rates[] index; treating
it as one can select an invalid PER curve and cause artificial packet loss.

Parse the flags, retain the original rates for transmit status, and map
20 MHz long-GI HT/VHT rates to the nearest available legacy OFDM PER curve.
The EasyMesh hwsim lab intentionally uses 20 MHz channels.

---
 wmediumd/wmediumd.c | 113 +++++++++++++++++++++++++++++++++++++++++---
 wmediumd/wmediumd.h |  13 +++++
 2 files changed, 121 insertions(+), 5 deletions(-)

diff --git a/wmediumd/wmediumd.h b/wmediumd/wmediumd.h
--- a/wmediumd/wmediumd.h
+++ b/wmediumd/wmediumd.h
@@ -104,6 +104,7 @@
 	HWSIM_ATTR_NO_VIF,
 	HWSIM_ATTR_FREQ,
 	HWSIM_ATTR_PAD,
+	HWSIM_ATTR_TX_INFO_FLAGS,
 	__HWSIM_ATTR_MAX,
 };
 #define HWSIM_ATTR_MAX (__HWSIM_ATTR_MAX - 1)
@@ -236,6 +237,16 @@
 	unsigned char count;
 };
 
+enum hwsim_tx_rate_flags {
+	MAC80211_HWSIM_TX_RC_MCS = 1 << 3,
+	MAC80211_HWSIM_TX_RC_VHT_MCS = 1 << 8,
+};
+
+struct hwsim_tx_rate_flag {
+	signed char idx;
+	uint16_t flags;
+} __attribute__((packed));
+
 struct frame {
 	struct list_head list;		/* frame queue list */
 	struct usfstl_job job;
@@ -248,8 +259,10 @@
 	int signal;
 	int duration;
 	int tx_rates_count;
+	int tx_rate_flags_count;
 	struct station *sender;
 	struct hwsim_tx_rate tx_rates[IEEE80211_TX_MAX_RATES];
+	struct hwsim_tx_rate_flag tx_rate_flags[IEEE80211_TX_MAX_RATES];
 	size_t data_len;
 	u8 data[0];			/* frame contents */
 };
diff --git a/wmediumd/wmediumd.c b/wmediumd/wmediumd.c
--- a/wmediumd/wmediumd.c
+++ b/wmediumd/wmediumd.c
@@ -519,6 +519,62 @@
 	fflush(ctx->pcap_file);
 }
 
+/*
+ * Linux 7 accompanies HWSIM_ATTR_TX_INFO with HWSIM_ATTR_TX_INFO_FLAGS.
+ * An idx carrying MCS/VHT_MCS is not a legacy hwsim_rates[] index.  wmediumd's
+ * PER model only contains legacy OFDM curves, so map the 20 MHz long-GI PHY
+ * rate to the nearest available OFDM curve.  The lab intentionally uses
+ * 20 MHz channels; width and short-GI refinements can be added with a native
+ * HT/VHT PER model later.
+ */
+static int model_rate_idx(int idx, uint16_t flags, u32 freq)
+{
+	static const int legacy_ofdm[] = {60, 90, 120, 180, 240, 360, 480, 540};
+	static const int ht20[] = {65, 130, 195, 260, 390, 520, 585, 650};
+	static const int vht20[] = {65, 130, 195, 260, 390, 520, 585, 650, 780, 867};
+	int mcs, nss, target, best = 0, best_delta, i;
+
+	if (idx < 0)
+		return idx;
+
+	if (flags & MAC80211_HWSIM_TX_RC_VHT_MCS) {
+		mcs = idx & 0x0f;
+		nss = ((idx >> 4) & 0x07) + 1;
+		if (mcs >= (int)(sizeof(vht20) / sizeof(vht20[0])))
+			mcs = sizeof(vht20) / sizeof(vht20[0]) - 1;
+		target = vht20[mcs] * nss;
+	} else if (flags & MAC80211_HWSIM_TX_RC_MCS) {
+		mcs = idx & 0x07;
+		nss = idx / 8 + 1;
+		target = ht20[mcs] * nss;
+	} else {
+		return idx;
+	}
+
+	best_delta = abs(target - legacy_ofdm[0]);
+	for (i = 1; i < (int)(sizeof(legacy_ofdm) / sizeof(legacy_ofdm[0])); i++) {
+		int delta = abs(target - legacy_ofdm[i]);
+
+		if (delta < best_delta) {
+			best = i;
+			best_delta = delta;
+		}
+	}
+
+	/* 2.4 GHz rateset indices include four CCK entries before OFDM. */
+	return best + (freq > 5000 ? 0 : 4);
+}
+
+static int frame_model_rate_idx(const struct frame *frame, int rate_slot)
+{
+	uint16_t flags = 0;
+
+	if (rate_slot >= 0 && rate_slot < frame->tx_rate_flags_count)
+		flags = frame->tx_rate_flags[rate_slot].flags;
+
+	return model_rate_idx(frame->tx_rates[rate_slot].idx, flags, frame->freq);
+}
+
 static void queue_frame(struct wmediumd *ctx, struct station *station,
 			struct frame *frame)
 {
@@ -534,7 +590,7 @@
 	bool is_acked = false;
 	bool noack = false;
 	int i, j;
-	int rate_idx;
+	int rate_idx, per_rate_idx;
 	int ac;
 
 	/* TODO configure phy parameters */
@@ -596,12 +652,13 @@
 		if (rate_idx < 0)
 			break;
 
-		error_prob = ctx->get_error_prob(ctx, snr, rate_idx,
+		per_rate_idx = frame_model_rate_idx(frame, i);
+		error_prob = ctx->get_error_prob(ctx, snr, per_rate_idx,
 						 frame->freq, frame->data_len,
 						 station, deststa);
 		for (j = 0; j < frame->tx_rates[i].count; j++) {
 			send_time += difs + pkt_duration(frame->data_len,
-				index_to_rate(rate_idx, frame->freq));
+				index_to_rate(per_rate_idx, frame->freq));
 
 			retries++;
 
@@ -915,7 +972,7 @@
 				snr -= get_signal_offset_by_interference(ctx,
 					frame->sender->index, station->index,
 					frame->freq);
-				rate_idx = frame->tx_rates[0].idx;
+				rate_idx = frame_model_rate_idx(frame, 0);
 				error_prob = ctx->get_error_prob(ctx,
 					(double)snr, rate_idx, frame->freq,
 					frame->data_len, frame->sender,
@@ -1048,7 +1105,14 @@
 				nla_len(attrs[HWSIM_ATTR_TX_INFO]);
 			struct hwsim_tx_rate *tx_rates =
 				(struct hwsim_tx_rate *)
-				nla_data(attrs[HWSIM_ATTR_TX_INFO]);
+					nla_data(attrs[HWSIM_ATTR_TX_INFO]);
+			unsigned int tx_rate_flags_len =
+				attrs[HWSIM_ATTR_TX_INFO_FLAGS] ?
+					nla_len(attrs[HWSIM_ATTR_TX_INFO_FLAGS]) : 0;
+			struct hwsim_tx_rate_flag *tx_rate_flags =
+				attrs[HWSIM_ATTR_TX_INFO_FLAGS] ?
+					(struct hwsim_tx_rate_flag *)
+						nla_data(attrs[HWSIM_ATTR_TX_INFO_FLAGS]) : NULL;
 			u64 cookie = nla_get_u64(attrs[HWSIM_ATTR_COOKIE]);
 			u32 freq;
 
@@ -1090,8 +1154,18 @@
 			  if (_owner) mc_update_vif_owner(_owner, src, freq); }   /* WMD 1/4 v2 */
 			frame->tx_rates_count =
 				tx_rates_len / sizeof(struct hwsim_tx_rate);
+			if (frame->tx_rates_count > IEEE80211_TX_MAX_RATES)
+				frame->tx_rates_count = IEEE80211_TX_MAX_RATES;
 			memcpy(frame->tx_rates, tx_rates,
 			       min(tx_rates_len, sizeof(frame->tx_rates)));
+			frame->tx_rate_flags_count = tx_rate_flags_len /
+				sizeof(struct hwsim_tx_rate_flag);
+			if (frame->tx_rate_flags_count > IEEE80211_TX_MAX_RATES)
+				frame->tx_rate_flags_count = IEEE80211_TX_MAX_RATES;
+			if (tx_rate_flags)
+				memcpy(frame->tx_rate_flags, tx_rate_flags,
+				       min(tx_rate_flags_len,
+					   sizeof(frame->tx_rate_flags)));
 			queue_frame(ctx, sender, frame);
 		}
 		break;
@@ -1467,7 +1541,7 @@
 	unsigned long sf, cf;
 	struct wmediumd t = {};
 
-	printf("=== wmediumd WMD3 (freq-scoped interference) + WMD1v2 (ownership) self-test ===\n");
+	printf("=== wmediumd multichannel + Linux 7 rate-flags self-test ===\n");
 
 	/* ---------- WMD3: frequency-scoped interference ---------- */
 	t.num_stas = 4;
@@ -1567,6 +1641,26 @@
 		else { printf("FAIL scheduling: cross-frequency tail serialized medium\n"); fails++; }
 	}
 
+	/* ---------- WMD5: Linux 7 HT/VHT rate flags ---------- */
+	{
+		int ht5 = model_rate_idx(9, MAC80211_HWSIM_TX_RC_MCS, 5180);
+		int ht24 = model_rate_idx(7, MAC80211_HWSIM_TX_RC_MCS, 2437);
+		int vht5 = model_rate_idx(9, MAC80211_HWSIM_TX_RC_VHT_MCS, 5180);
+		double ht_per = get_error_prob_from_snr(50, ht5, 5180, 1500);
+		double vht_per = get_error_prob_from_snr(50, vht5, 5180, 1500);
+
+		if (ht5 >= 0 && ht5 <= 7 && ht24 >= 4 && ht24 <= 11 &&
+		    vht5 >= 0 && vht5 <= 7 && ht_per < 1.0 && vht_per < 1.0 &&
+		    model_rate_idx(3, 0, 5180) == 3)
+			printf("PASS Linux 7 rates: HT/VHT mapped to valid OFDM PER curves (ht5=%d ht24=%d vht5=%d)\n",
+			       ht5, ht24, vht5);
+		else {
+			printf("FAIL Linux 7 rates: ht5=%d ht24=%d vht5=%d htPER=%f vhtPER=%f\n",
+			       ht5, ht24, vht5, ht_per, vht_per);
+			fails++;
+		}
+	}
+
 	printf("=== self-test %s (%d failures) ===\n", fails ? "FAILED" : "PASSED", fails);
 	return fails ? 1 : 0;
 }
