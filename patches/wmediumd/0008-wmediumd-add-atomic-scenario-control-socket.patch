new file mode 100644
index 0000000..7b8ae0d
--- /dev/null
+++ b/wmediumd/control.c
@@ -0,0 +1,302 @@
+/*
+ * Dedicated atomic scenario control for the EasyMesh hwsim laboratory.
+ * SPDX-License-Identifier: GPL-2.0
+ */
+#include <endian.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/random.h>
+#include <sys/socket.h>
+#include <sys/stat.h>
+#include <time.h>
+#include <unistd.h>
+
+#include <usfstl/loop.h>
+#include <usfstl/uds.h>
+
+#include "control.h"
+#include "wmediumd.h"
+
+struct wmd_control_client {
+	struct usfstl_loop_entry loop;
+	struct wmediumd *ctx;
+};
+
+struct resolved_update {
+	int source;
+	int destination;
+	int snr_db;
+};
+
+static int station_index(struct wmediumd *ctx, const uint8_t *address)
+{
+	int i;
+
+	for (i = 0; i < ctx->num_stas; i++)
+		if (memcmp(ctx->sta_array[i]->addr, address, 6) == 0)
+			return i;
+	return -1;
+}
+
+static int send_response(int fd, uint16_t opcode, uint32_t status,
+			 uint64_t generation, const void *payload,
+			 uint32_t payload_len)
+{
+	uint8_t *frame;
+	struct wmdc_header *header;
+	ssize_t sent;
+
+	if (sizeof(*header) + payload_len > WMDC_MAX_FRAME)
+		return -1;
+	frame = calloc(1, sizeof(*header) + payload_len);
+	if (!frame)
+		return -1;
+	header = (struct wmdc_header *)frame;
+	header->magic = htobe32(WMDC_MAGIC);
+	header->version = htobe16(WMDC_VERSION);
+	header->opcode = htobe16(opcode);
+	header->payload_len = htobe32(payload_len);
+	header->status = htobe32(status);
+	header->generation = htobe64(generation);
+	if (payload_len)
+		memcpy(frame + sizeof(*header), payload, payload_len);
+	sent = send(fd, frame, sizeof(*header) + payload_len, MSG_NOSIGNAL);
+	free(frame);
+	return sent == (ssize_t)(sizeof(*header) + payload_len) ? 0 : -1;
+}
+
+static int send_info(struct wmd_control_client *client, uint16_t opcode)
+{
+	struct wmediumd *ctx = client->ctx;
+	struct wmdc_info info = {
+		.instance_hi = htobe64(ctx->control_instance_hi),
+		.instance_lo = htobe64(ctx->control_instance_lo),
+		.capabilities = htobe32(WMDC_CAP_RADIO_PAIR_SNR |
+			WMDC_CAP_ATOMIC_GENERATIONS | WMDC_CAP_READBACK |
+			WMDC_CAP_DUMP),
+		.max_updates = htobe32(ctx->num_stas * ctx->num_stas),
+		.num_stations = htobe32(ctx->num_stas),
+	};
+
+	return send_response(client->loop.fd, opcode, WMDC_OK,
+			     ctx->control_generation, &info, sizeof(info));
+}
+
+static int resolve_links(struct wmediumd *ctx, const uint8_t *payload,
+			 uint32_t count, struct resolved_update *resolved,
+			 bool require_value)
+{
+	const struct wmdc_link *links = (const struct wmdc_link *)payload;
+	uint32_t i;
+
+	for (i = 0; i < count; i++) {
+		resolved[i].source = station_index(ctx, links[i].source);
+		resolved[i].destination = station_index(ctx, links[i].destination);
+		resolved[i].snr_db = (int16_t)be16toh((uint16_t)links[i].snr_db);
+		if (resolved[i].source < 0 || resolved[i].destination < 0)
+			return WMDC_ERR_IDENTITY;
+		if (require_value &&
+		    (resolved[i].snr_db < -20 || resolved[i].snr_db > 60))
+			return WMDC_ERR_VALUE;
+	}
+	return WMDC_OK;
+}
+
+static int handle_apply(struct wmd_control_client *client,
+			const struct wmdc_header *request,
+			const uint8_t *payload, uint32_t payload_len)
+{
+	struct wmediumd *ctx = client->ctx;
+	struct resolved_update *resolved;
+	uint64_t generation = be64toh(request->generation);
+	uint32_t count, i;
+	int status;
+
+	if (!payload_len || payload_len % sizeof(struct wmdc_link))
+		return send_response(client->loop.fd, WMDC_OP_APPLY,
+			WMDC_ERR_LENGTH, ctx->control_generation, NULL, 0);
+	count = payload_len / sizeof(struct wmdc_link);
+	if (count > (uint32_t)(ctx->num_stas * ctx->num_stas))
+		return send_response(client->loop.fd, WMDC_OP_APPLY,
+			WMDC_ERR_LENGTH, ctx->control_generation, NULL, 0);
+	if (generation != ctx->control_generation + 1)
+		return send_response(client->loop.fd, WMDC_OP_APPLY,
+			WMDC_ERR_GENERATION, ctx->control_generation, NULL, 0);
+	resolved = calloc(count, sizeof(*resolved));
+	if (!resolved)
+		return send_response(client->loop.fd, WMDC_OP_APPLY,
+			WMDC_ERR_INTERNAL, ctx->control_generation, NULL, 0);
+	status = resolve_links(ctx, payload, count, resolved, true);
+	if (status != WMDC_OK) {
+		free(resolved);
+		return send_response(client->loop.fd, WMDC_OP_APPLY, status,
+			ctx->control_generation, NULL, 0);
+	}
+	/* Validation is complete. Only this loop mutates the live matrix. */
+	for (i = 0; i < count; i++)
+		ctx->snr_matrix[resolved[i].source * ctx->num_stas +
+			resolved[i].destination] = resolved[i].snr_db;
+	ctx->control_generation = generation;
+	free(resolved);
+	return send_response(client->loop.fd, WMDC_OP_APPLY, WMDC_OK,
+			generation, payload, payload_len);
+}
+
+static int handle_get(struct wmd_control_client *client,
+		      const uint8_t *payload, uint32_t payload_len)
+{
+	struct wmediumd *ctx = client->ctx;
+	struct resolved_update resolved;
+	struct wmdc_link response;
+	int status;
+
+	if (payload_len != sizeof(response))
+		return send_response(client->loop.fd, WMDC_OP_GET_LINK,
+			WMDC_ERR_LENGTH, ctx->control_generation, NULL, 0);
+	status = resolve_links(ctx, payload, 1, &resolved, false);
+	if (status != WMDC_OK)
+		return send_response(client->loop.fd, WMDC_OP_GET_LINK, status,
+			ctx->control_generation, NULL, 0);
+	memcpy(&response, payload, sizeof(response));
+	response.snr_db = htobe16((uint16_t)ctx->snr_matrix[
+		resolved.source * ctx->num_stas + resolved.destination]);
+	response.reserved = 0;
+	return send_response(client->loop.fd, WMDC_OP_GET_LINK, WMDC_OK,
+			ctx->control_generation, &response, sizeof(response));
+}
+
+static int handle_dump(struct wmd_control_client *client)
+{
+	struct wmediumd *ctx = client->ctx;
+	struct wmdc_link *links;
+	uint32_t count = 0;
+	int i, j, result;
+
+	links = calloc(ctx->num_stas * ctx->num_stas, sizeof(*links));
+	if (!links)
+		return send_response(client->loop.fd, WMDC_OP_DUMP_LINKS,
+			WMDC_ERR_INTERNAL, ctx->control_generation, NULL, 0);
+	for (i = 0; i < ctx->num_stas; i++) {
+		for (j = 0; j < ctx->num_stas; j++) {
+			if (i == j)
+				continue;
+			memcpy(links[count].source, ctx->sta_array[i]->addr, 6);
+			memcpy(links[count].destination, ctx->sta_array[j]->addr, 6);
+			links[count].snr_db = htobe16((uint16_t)
+				ctx->snr_matrix[i * ctx->num_stas + j]);
+			count++;
+		}
+	}
+	result = send_response(client->loop.fd, WMDC_OP_DUMP_LINKS, WMDC_OK,
+			       ctx->control_generation, links,
+			       count * sizeof(*links));
+	free(links);
+	return result;
+}
+
+static void control_disconnect(struct wmd_control_client *client)
+{
+	client->ctx->control_client_active = false;
+	usfstl_loop_unregister(&client->loop);
+	close(client->loop.fd);
+	free(client);
+}
+
+static void control_handler(struct usfstl_loop_entry *entry)
+{
+	struct wmd_control_client *client =
+		container_of(entry, struct wmd_control_client, loop);
+	uint8_t frame[WMDC_MAX_FRAME];
+	struct wmdc_header *header = (struct wmdc_header *)frame;
+	uint32_t payload_len;
+	uint16_t opcode;
+	ssize_t length;
+	int result = -1;
+
+	length = recv(entry->fd, frame, sizeof(frame), 0);
+	if (length <= 0) {
+		control_disconnect(client);
+		return;
+	}
+	if (length < (ssize_t)sizeof(*header) ||
+	    be32toh(header->magic) != WMDC_MAGIC ||
+	    be16toh(header->version) != WMDC_VERSION) {
+		send_response(entry->fd, 0, WMDC_ERR_PROTOCOL,
+			      client->ctx->control_generation, NULL, 0);
+		return;
+	}
+	payload_len = be32toh(header->payload_len);
+	opcode = be16toh(header->opcode);
+	if (payload_len != (uint32_t)(length - sizeof(*header))) {
+		send_response(entry->fd, opcode, WMDC_ERR_LENGTH,
+			      client->ctx->control_generation, NULL, 0);
+		return;
+	}
+	switch (opcode) {
+	case WMDC_OP_HELLO:
+	case WMDC_OP_STATUS:
+		if (payload_len == 0)
+			result = send_info(client, opcode);
+		break;
+	case WMDC_OP_APPLY:
+		result = handle_apply(client, header, frame + sizeof(*header),
+				      payload_len);
+		break;
+	case WMDC_OP_GET_LINK:
+		result = handle_get(client, frame + sizeof(*header), payload_len);
+		break;
+	case WMDC_OP_DUMP_LINKS:
+		if (payload_len == 0)
+			result = handle_dump(client);
+		break;
+	default:
+		break;
+	}
+	if (result < 0)
+		control_disconnect(client);
+}
+
+static void control_connected(int fd, void *data)
+{
+	struct wmediumd *ctx = data;
+	struct wmd_control_client *client;
+
+	if (fd < 0)
+		return;
+	if (ctx->control_client_active) {
+		close(fd);
+		return;
+	}
+	client = calloc(1, sizeof(*client));
+	if (!client) {
+		close(fd);
+		return;
+	}
+	ctx->control_client_active = true;
+	client->ctx = ctx;
+	client->loop.fd = fd;
+	client->loop.handler = control_handler;
+	usfstl_loop_register(&client->loop);
+}
+
+void wmd_control_start(struct wmediumd *ctx, const char *path)
+{
+	uint64_t instance[2];
+	ssize_t bytes;
+
+	bytes = getrandom(instance, sizeof(instance), 0);
+	if (bytes != sizeof(instance)) {
+		instance[0] = (uint64_t)time(NULL);
+		instance[1] = ((uint64_t)getpid() << 32) ^ (uint64_t)clock();
+	}
+	ctx->control_instance_hi = instance[0];
+	ctx->control_instance_lo = instance[1];
+	ctx->control_generation = 0;
+	ctx->control_client_active = false;
+	usfstl_uds_create_seqpacket(path, control_connected, ctx);
+	chmod(path, 0660);
+}
