--- /dev/null
+++ b/wmediumd/control.h
@@ -0,0 +1,65 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef WMEDIUMD_CONTROL_H
+#define WMEDIUMD_CONTROL_H
+
+#include <stdint.h>
+
+struct wmediumd;
+
+#define WMDC_MAGIC 0x574d4443U
+#define WMDC_VERSION 1
+#define WMDC_MAX_FRAME (64U * 1024U)
+
+enum wmdc_opcode {
+	WMDC_OP_HELLO = 1,
+	WMDC_OP_STATUS = 2,
+	WMDC_OP_APPLY = 3,
+	WMDC_OP_GET_LINK = 4,
+	WMDC_OP_DUMP_LINKS = 5,
+};
+
+enum wmdc_status {
+	WMDC_OK = 0,
+	WMDC_ERR_PROTOCOL = 1,
+	WMDC_ERR_LENGTH = 2,
+	WMDC_ERR_GENERATION = 3,
+	WMDC_ERR_IDENTITY = 4,
+	WMDC_ERR_VALUE = 5,
+	WMDC_ERR_INTERNAL = 6,
+};
+
+enum wmdc_capability {
+	WMDC_CAP_RADIO_PAIR_SNR = 1U << 0,
+	WMDC_CAP_ATOMIC_GENERATIONS = 1U << 1,
+	WMDC_CAP_READBACK = 1U << 2,
+	WMDC_CAP_DUMP = 1U << 3,
+};
+
+struct wmdc_header {
+	uint32_t magic;
+	uint16_t version;
+	uint16_t opcode;
+	uint32_t payload_len;
+	uint32_t status;
+	uint64_t generation;
+} __attribute__((packed));
+
+struct wmdc_link {
+	uint8_t source[6];
+	uint8_t destination[6];
+	int16_t snr_db;
+	uint16_t reserved;
+} __attribute__((packed));
+
+struct wmdc_info {
+	uint64_t instance_hi;
+	uint64_t instance_lo;
+	uint32_t capabilities;
+	uint32_t max_updates;
+	uint32_t num_stations;
+	uint32_t reserved;
+} __attribute__((packed));
+
+void wmd_control_start(struct wmediumd *ctx, const char *path);
+
+#endif
