+void wmd_control_start_observer(struct wmediumd *ctx, const char *path)
+{
+	if (wmd_telemetry_init(ctx) < 0)
+		return;
+	control_listener_start(ctx, path, true, true);
+}
+
+int wmd_telemetry_selftest(void)
+{
+	struct wmediumd ctx = {.num_stas = 2};
+	struct station source = {.index = 0}, destination = {.index = 1};
+	struct station *stations[] = {&source, &destination};
+	struct frame *frame;
+	uint8_t vif[6] = {0x02, 0, 0, 0, 0, 1};
+	int failures = 0;
+
+	source.addr[5] = 1;
+	destination.addr[5] = 2;
+	ctx.sta_array = stations;
+	if (wmd_telemetry_init(&ctx) < 0)
+		return 1;
+	frame = calloc(1, sizeof(*frame) + 32);
+	if (!frame)
+		return 1;
+	frame->sender = &source;
+	frame->freq = 5180;
+	frame->data_len = 32;
+	frame->data[0] = FTYPE_DATA;
+	frame->data[4] = destination.addr[0];
+	wmd_telemetry_record_tx(&ctx, frame, &destination, IEEE80211_AC_BE,
+		2, 1, true, false, false, 30, 0.125, 400);
+	wmd_telemetry_record_rx(&ctx, frame, &destination,
+		WMD_TELEMETRY_RX_INJECTED, -61, 30, 0.125);
+	wmd_telemetry_frame_done(&ctx);
+	wmd_telemetry_vif_update(&ctx, vif, &destination, 5180, true);
+	wmd_telemetry_generation(&ctx, 3, true, 2);
+	wmd_telemetry_netlink_rejection(&ctx, &source, &destination, 5180,
+		-EINVAL, true);
+	if (ctx.telemetry->frames_seen != 1 || ctx.telemetry->bytes_seen != 32 ||
+	    ctx.telemetry->tx_attempts != 2 || ctx.telemetry->retries != 1 ||
+	    ctx.telemetry->rx_injected != 1 || ctx.telemetry->queue_depth != 0 ||
+	    ctx.telemetry->queue_depth_max != 1 ||
+	    ctx.telemetry->netlink_clone_einval != 1 ||
+	    telemetry_count_active_links(ctx.telemetry) != 1 ||
+	    telemetry_count_radio_frequencies(ctx.telemetry) != 1 ||
+	    telemetry_count_vifs(ctx.telemetry) != 1 ||
+	    ctx.telemetry->event_count < 4)
+		failures++;
+	free(frame);
+	free(ctx.telemetry->active_links);
+	free(ctx.telemetry->radio_frequencies);
+	free(ctx.telemetry->vifs);
+	free(ctx.telemetry);
+	return failures;
 }
