+static int handle_event_dump(struct wmd_control_client *client,
+			     const uint8_t *payload, uint32_t payload_len)
+{
+	struct wmd_telemetry *telemetry = client->ctx->telemetry;
+	struct wmdc_event *entries;
+	uint64_t since, oldest_sequence;
+	uint32_t cursor, limit, total = 0, count = 0, matched = 0;
+	uint32_t flags = 0, next = WMDC_PAGE_END;
+	uint32_t oldest_index;
+	uint64_t offset;
+	int status, result;
+
+	status = telemetry_page_request(payload, payload_len, sizeof(*entries),
+		&since, &cursor, &limit);
+	if (status != WMDC_OK)
+		return send_response(client->loop.fd, WMDC_OP_DUMP_EVENTS,
+			status, client->ctx->control_generation, NULL, 0);
+	entries = calloc(limit, sizeof(*entries));
+	if (!entries)
+		return send_response(client->loop.fd, WMDC_OP_DUMP_EVENTS,
+			WMDC_ERR_INTERNAL, client->ctx->control_generation, NULL, 0);
+	oldest_sequence = telemetry_oldest_event_sequence(telemetry);
+	if (since && oldest_sequence && since < oldest_sequence - 1)
+		flags |= WMDC_PAGE_GAP;
+	oldest_index = (telemetry->event_write_index + WMDT_EVENT_CAPACITY -
+		telemetry->event_count) % WMDT_EVENT_CAPACITY;
+	for (offset = 0; offset < telemetry->event_count; offset++) {
+		struct wmdt_event_state *state = &telemetry->events[
+			(oldest_index + offset) % WMDT_EVENT_CAPACITY];
+		struct wmdc_event *entry;
+
+		if (state->sequence <= since)
+			continue;
+		total++;
+		if (matched++ < cursor || count == limit)
+			continue;
+		entry = &entries[count++];
+		entry->sequence = htobe64(state->sequence);
+		entry->time_usec = htobe64(state->time_usec);
+		entry->type = htobe32(state->type);
+		entry->value = htobe32((uint32_t)state->value);
+		if (state->source >= 0)
+			memcpy(entry->source,
+			       client->ctx->sta_array[state->source]->addr, 6);
+		if (state->destination >= 0)
+			memcpy(entry->destination,
+			       client->ctx->sta_array[state->destination]->addr, 6);
+		entry->frequency_mhz = htobe32(state->frequency_mhz);
+		entry->auxiliary = htobe32(state->auxiliary);
+	}
+	if (cursor + count < total) {
+		next = cursor + count;
+		flags |= WMDC_PAGE_MORE;
+	}
+	result = send_telemetry_page(client, WMDC_OP_DUMP_EVENTS,
+		telemetry->sequence, oldest_sequence, total, next, flags,
+		entries, count, sizeof(*entries));
+	free(entries);
+	return result;
+}
