+static int handle_radio_frequency_dump(struct wmd_control_client *client,
+				       const uint8_t *payload,
+				       uint32_t payload_len)
+{
+	struct wmd_telemetry *telemetry = client->ctx->telemetry;
+	struct wmdc_radio_frequency *entries;
+	uint64_t since;
+	uint32_t cursor, limit, total = 0, count = 0, next = WMDC_PAGE_END;
+	size_t i;
+	int status, result;
+
+	status = telemetry_page_request(payload, payload_len, sizeof(*entries),
+		&since, &cursor, &limit);
+	if (status != WMDC_OK || cursor > telemetry->radio_frequency_capacity)
+		return send_response(client->loop.fd,
+			WMDC_OP_DUMP_RADIO_FREQUENCIES,
+			status == WMDC_OK ? WMDC_ERR_VALUE : status,
+			client->ctx->control_generation, NULL, 0);
+	entries = calloc(limit, sizeof(*entries));
+	if (!entries)
+		return send_response(client->loop.fd,
+			WMDC_OP_DUMP_RADIO_FREQUENCIES, WMDC_ERR_INTERNAL,
+			client->ctx->control_generation, NULL, 0);
+	for (i = 0; i < telemetry->radio_frequency_capacity; i++)
+		if (telemetry->radio_frequencies[i].active &&
+		    telemetry->radio_frequencies[i].last_update_sequence > since)
+			total++;
+	for (i = cursor; i < telemetry->radio_frequency_capacity && count < limit; i++) {
+		struct wmdt_radio_frequency_state *state =
+			&telemetry->radio_frequencies[i];
+		struct wmdc_radio_frequency *entry;
+
+		if (!state->active || state->last_update_sequence <= since)
+			continue;
+		entry = &entries[count++];
+		memcpy(entry->radio, client->ctx->sta_array[state->radio]->addr, 6);
+		entry->frequency_mhz = htobe32(state->frequency_mhz);
+		entry->last_update_sequence = htobe64(state->last_update_sequence);
+		entry->last_seen_usec = htobe64(state->last_seen_usec);
+		entry->frames = htobe64(state->frames);
+		entry->bytes = htobe64(state->bytes);
+		entry->management_frames = htobe64(state->frame_types[0]);
+		entry->control_frames = htobe64(state->frame_types[1]);
+		entry->data_frames = htobe64(state->frame_types[2]);
+		entry->eapol_frames = htobe64(state->eapol_frames);
+		entry->unicast_frames = htobe64(state->unicast_frames);
+		entry->multicast_frames = htobe64(state->multicast_frames);
+		entry->attempts = htobe64(state->attempts);
+		entry->retries = htobe64(state->retries);
+		entry->rx_injected = htobe64(state->rx_injected);
+		entry->drops = htobe64(state->drops);
+		entry->queue_depth_max = htobe32(state->queue_depth_max);
+		entry->last_type = state->last_type;
+		entry->last_subtype = state->last_subtype;
+		entry->last_access_category = state->last_access_category;
+	}
+	for (; i < telemetry->radio_frequency_capacity; i++)
+		if (telemetry->radio_frequencies[i].active &&
+		    telemetry->radio_frequencies[i].last_update_sequence > since) {
+			next = i;
+			break;
+		}
+	result = send_telemetry_page(client, WMDC_OP_DUMP_RADIO_FREQUENCIES,
+		telemetry->sequence, telemetry_oldest_event_sequence(telemetry),
+		total, next, next == WMDC_PAGE_END ? 0 : WMDC_PAGE_MORE,
+		entries, count, sizeof(*entries));
+	free(entries);
+	return result;
+}
