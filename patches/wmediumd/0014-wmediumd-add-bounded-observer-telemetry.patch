+static int wmd_telemetry_init(struct wmediumd *ctx)
+{
+	size_t active_capacity, potential_links;
+
+	if (ctx->telemetry)
+		return 0;
+	ctx->telemetry = calloc(1, sizeof(*ctx->telemetry));
+	if (!ctx->telemetry)
+		return -1;
+	potential_links = (size_t)ctx->num_stas * ctx->num_stas;
+	active_capacity = potential_links * WMDC_FREQUENCY_SLOTS_PER_PAIR;
+	if (active_capacity > WMDT_ACTIVE_LINK_LIMIT)
+		active_capacity = WMDT_ACTIVE_LINK_LIMIT;
+	ctx->telemetry->active_link_capacity = active_capacity;
+	ctx->telemetry->radio_frequency_capacity =
+		(size_t)ctx->num_stas * WMDT_FREQUENCIES_PER_RADIO;
+	ctx->telemetry->vif_capacity =
+		(size_t)ctx->num_stas * WMDT_VIFS_PER_RADIO;
+	ctx->telemetry->active_links = calloc(active_capacity,
+		sizeof(*ctx->telemetry->active_links));
+	ctx->telemetry->radio_frequencies = calloc(
+		ctx->telemetry->radio_frequency_capacity,
+		sizeof(*ctx->telemetry->radio_frequencies));
+	ctx->telemetry->vifs = calloc(ctx->telemetry->vif_capacity,
+		sizeof(*ctx->telemetry->vifs));
+	if (!ctx->telemetry->active_links ||
+	    !ctx->telemetry->radio_frequencies || !ctx->telemetry->vifs) {
+		free(ctx->telemetry->active_links);
+		free(ctx->telemetry->radio_frequencies);
+		free(ctx->telemetry->vifs);
+		free(ctx->telemetry);
+		ctx->telemetry = NULL;
+		return -1;
+	}
+	return 0;
