+static uint64_t telemetry_oldest_event_sequence(const struct wmd_telemetry *telemetry)
+{
+	uint32_t oldest;
+
+	if (!telemetry || !telemetry->event_count)
+		return 0;
+	oldest = (telemetry->event_write_index + WMDT_EVENT_CAPACITY -
+		  telemetry->event_count) % WMDT_EVENT_CAPACITY;
+	return telemetry->events[oldest].sequence;
+}
+
+static int telemetry_page_request(const uint8_t *payload, uint32_t payload_len,
+				  size_t entry_size, uint64_t *since,
+				  uint32_t *cursor, uint32_t *limit)
+{
+	const struct wmdc_page_request *request;
+	uint32_t maximum = (WMDC_MAX_FRAME - sizeof(struct wmdc_header) -
+			    sizeof(struct wmdc_page_header)) / entry_size;
+
+	if (!payload_len) {
+		*since = 0;
+		*cursor = 0;
+		*limit = maximum < 128 ? maximum : 128;
+		return WMDC_OK;
+	}
+	if (payload_len != sizeof(*request))
+		return WMDC_ERR_LENGTH;
+	request = (const struct wmdc_page_request *)payload;
+	*since = be64toh(request->since_sequence);
+	*cursor = be32toh(request->cursor);
+	*limit = be32toh(request->limit);
+	if (!*limit)
+		*limit = maximum < 128 ? maximum : 128;
+	if (*limit > maximum)
+		*limit = maximum;
+	return WMDC_OK;
+}
+
+static int send_telemetry_page(struct wmd_control_client *client,
+			       uint16_t opcode, uint64_t snapshot,
+			       uint64_t oldest_event, uint32_t total,
+			       uint32_t next_cursor, uint32_t flags,
+			       const void *entries, uint32_t count,
+			       size_t entry_size)
+{
+	struct wmdc_page_header *header;
+	uint8_t *payload;
+	uint32_t payload_len = sizeof(*header) + count * entry_size;
+	int result;
+
+	payload = calloc(1, payload_len);
+	if (!payload)
+		return send_response(client->loop.fd, opcode, WMDC_ERR_INTERNAL,
+			client->ctx->control_generation, NULL, 0);
+	header = (struct wmdc_page_header *)payload;
+	header->snapshot_sequence = htobe64(snapshot);
+	header->oldest_event_sequence = htobe64(oldest_event);
+	header->total = htobe32(total);
+	header->next_cursor = htobe32(next_cursor);
+	header->flags = htobe32(flags);
+	if (count)
+		memcpy(payload + sizeof(*header), entries, count * entry_size);
+	result = send_response(client->loop.fd, opcode, WMDC_OK,
+		client->ctx->control_generation, payload, payload_len);
+	free(payload);
+	return result;
+}
