From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Rob Vogelaar <rob.vogelaar@libertyglobal.com>
Date: Mon, 24 Aug 2026 00:00:00 -0700
Subject: [PATCH] wmediumd: expose bounded observer telemetry

Add a separate host-only, read-only observer endpoint with bounded cumulative
packet and outcome counters, sparse active-link and radio-frequency state,
learned VIF ownership, queue health, attributed netlink rejections, paged delta
dumps, and a low-rate event ring. Keep the existing scenario and HAL metrics
sockets unchanged.

---
diff --git a/wmediumd/control.c b/wmediumd/control.c
index 58f5499..a9cd27a 100644
--- a/wmediumd/control.c
+++ b/wmediumd/control.c
@@ -25,11 +25,13 @@ struct wmd_control_client {
 	struct usfstl_loop_entry loop;
 	struct wmediumd *ctx;
 	bool read_only;
+	bool telemetry;
 };
 
 struct wmd_control_listener {
 	struct wmediumd *ctx;
 	bool read_only;
+	bool telemetry;
 };
 
 struct resolved_update {
@@ -50,6 +52,325 @@ struct resolved_frequency_update {
 #define WMDC_FREQUENCY_MIN_MHZ 2300U
 #define WMDC_FREQUENCY_MAX_MHZ 7125U
 #define WMDC_FREQUENCY_SLOTS_PER_PAIR 4U
+#define WMDT_ACTIVE_LINK_LIMIT 4096U
+#define WMDT_FREQUENCIES_PER_RADIO 8U
+#define WMDT_VIFS_PER_RADIO 16U
+#define WMDT_EVENT_CAPACITY 1024U
+
+struct wmdt_radio_frequency_state {
+	bool active;
+	int radio;
+	uint32_t frequency_mhz;
+	uint64_t last_update_sequence;
+	uint64_t last_seen_usec;
+	uint64_t frames;
+	uint64_t bytes;
+	uint64_t frame_types[4];
+	uint64_t eapol_frames;
+	uint64_t unicast_frames;
+	uint64_t multicast_frames;
+	uint64_t attempts;
+	uint64_t retries;
+	uint64_t rx_injected;
+	uint64_t drops;
+	uint32_t queue_depth_max;
+	uint8_t last_type;
+	uint8_t last_subtype;
+	uint8_t last_access_category;
+};
+
+struct wmdt_active_link_state {
+	bool active;
+	int source;
+	int destination;
+	uint32_t frequency_mhz;
+	uint32_t flags;
+	uint64_t last_update_sequence;
+	uint64_t first_seen_usec;
+	uint64_t last_seen_usec;
+	uint64_t frames;
+	uint64_t bytes;
+	uint64_t attempts;
+	uint64_t retries;
+	uint64_t acked;
+	uint64_t no_ack;
+	uint64_t rx_injected;
+	uint64_t drops_offchannel;
+	uint64_t drops_cca;
+	uint64_t drops_interference;
+	uint64_t drops_per;
+	uint64_t drops_no_receiver;
+	uint64_t netlink_rejections;
+	int32_t last_signal_dbm;
+	int32_t last_snr_db;
+	uint32_t last_per_million;
+	uint8_t last_type;
+	uint8_t last_subtype;
+	uint8_t last_access_category;
+};
+
+struct wmdt_vif_state {
+	bool active;
+	uint8_t vif[6];
+	int radio;
+	uint32_t frequency_mhz;
+	uint64_t last_update_sequence;
+};
+
+struct wmdt_event_state {
+	uint64_t sequence;
+	uint64_t time_usec;
+	uint32_t type;
+	int32_t value;
+	int source;
+	int destination;
+	uint32_t frequency_mhz;
+	uint32_t auxiliary;
+};
+
+struct wmd_telemetry {
+	uint64_t sequence;
+	uint64_t frames_seen;
+	uint64_t bytes_seen;
+	uint64_t frame_types[4];
+	uint64_t eapol_frames;
+	uint64_t unicast_frames;
+	uint64_t multicast_frames;
+	uint64_t tx_attempts;
+	uint64_t retries;
+	uint64_t tx_acked;
+	uint64_t tx_no_ack;
+	uint64_t rx_injected;
+	uint64_t multicast_candidates;
+	uint64_t drops_offchannel;
+	uint64_t drops_cca;
+	uint64_t drops_interference;
+	uint64_t drops_per;
+	uint64_t drops_no_receiver;
+	uint64_t netlink_clone_einval;
+	uint64_t netlink_other_errors;
+	uint64_t active_link_evictions;
+	uint64_t event_overruns;
+	uint64_t queue_delay_usec_max;
+	uint64_t queue_delay_usec_last;
+	uint32_t queue_depth;
+	uint32_t queue_depth_max;
+	struct wmdt_radio_frequency_state *radio_frequencies;
+	size_t radio_frequency_capacity;
+	struct wmdt_active_link_state *active_links;
+	size_t active_link_capacity;
+	struct wmdt_vif_state *vifs;
+	size_t vif_capacity;
+	struct wmdt_event_state events[WMDT_EVENT_CAPACITY];
+	uint64_t event_next_sequence;
+	uint64_t event_count;
+	uint32_t event_write_index;
+};
+
+static uint64_t telemetry_now_usec(void)
+{
+	return scheduler.current_time;
+}
+
+static uint32_t telemetry_probability(double probability)
+{
+	if (probability <= 0.0)
+		return 0;
+	if (probability >= 1.0)
+		return 1000000;
+	return (uint32_t)(probability * 1000000.0 + 0.5);
+}
+
+static uint8_t telemetry_frame_type(const struct frame *frame)
+{
+	uint8_t type;
+
+	if (frame->data_len < 2)
+		return 3;
+	type = frame->data[0] & FCTL_FTYPE;
+	if (type == FTYPE_MGMT)
+		return 0;
+	if (type == 0x04)
+		return 1;
+	if (type == FTYPE_DATA)
+		return 2;
+	return 3;
+}
+
+static uint8_t telemetry_frame_subtype(const struct frame *frame)
+{
+	return frame->data_len ? (frame->data[0] >> 4) & 0x0f : 0;
+}
+
+static bool telemetry_frame_is_eapol(const struct frame *frame)
+{
+	size_t header_len = 24;
+
+	if (telemetry_frame_type(frame) != 2 || frame->data_len < header_len ||
+	    (frame->data[1] & 0x40))
+		return false;
+	if ((frame->data[1] & (FCTL_TODS | FCTL_FROMDS)) ==
+	    (FCTL_TODS | FCTL_FROMDS))
+		header_len += 6;
+	if ((frame->data[0] & (FCTL_FTYPE | STYPE_QOS_DATA)) ==
+	    (FTYPE_DATA | STYPE_QOS_DATA))
+		header_len += 2;
+	if (frame->data_len < header_len + 8)
+		return false;
+	return memcmp(frame->data + header_len,
+		      "\xaa\xaa\x03\x00\x00\x00\x88\x8e", 8) == 0;
+}
+
+static void telemetry_event(struct wmediumd *ctx, uint32_t type,
+			    int source, int destination, uint32_t frequency_mhz,
+			    int32_t value, uint32_t auxiliary)
+{
+	struct wmd_telemetry *telemetry = ctx->telemetry;
+	struct wmdt_event_state *event;
+	uint64_t event_sequence;
+
+	if (!telemetry)
+		return;
+	event_sequence = ++telemetry->sequence;
+	telemetry->event_next_sequence = event_sequence;
+	event = &telemetry->events[telemetry->event_write_index];
+	telemetry->event_write_index =
+		(telemetry->event_write_index + 1) % WMDT_EVENT_CAPACITY;
+	if (telemetry->event_count == WMDT_EVENT_CAPACITY)
+		telemetry->event_overruns++;
+	else
+		telemetry->event_count++;
+	*event = (struct wmdt_event_state) {
+		.sequence = event_sequence,
+		.time_usec = telemetry_now_usec(),
+		.type = type,
+		.value = value,
+		.source = source,
+		.destination = destination,
+		.frequency_mhz = frequency_mhz,
+		.auxiliary = auxiliary,
+	};
+}
+
+static struct wmdt_radio_frequency_state *
+telemetry_radio_frequency(struct wmediumd *ctx, int radio,
+			  uint32_t frequency_mhz, bool create)
+{
+	struct wmd_telemetry *telemetry = ctx->telemetry;
+	struct wmdt_radio_frequency_state *free_slot = NULL;
+	size_t i;
+
+	if (!telemetry)
+		return NULL;
+	for (i = 0; i < telemetry->radio_frequency_capacity; i++) {
+		struct wmdt_radio_frequency_state *entry =
+			&telemetry->radio_frequencies[i];
+
+		if (entry->active && entry->radio == radio &&
+		    entry->frequency_mhz == frequency_mhz)
+			return entry;
+		if (!entry->active && !free_slot)
+			free_slot = entry;
+	}
+	if (!create || !free_slot)
+		return NULL;
+	*free_slot = (struct wmdt_radio_frequency_state) {
+		.active = true,
+		.radio = radio,
+		.frequency_mhz = frequency_mhz,
+	};
+	return free_slot;
+}
+
+static struct wmdt_active_link_state *
+telemetry_active_link(struct wmediumd *ctx, int source, int destination,
+		      uint32_t frequency_mhz, bool create)
+{
+	struct wmd_telemetry *telemetry = ctx->telemetry;
+	struct wmdt_active_link_state *free_slot = NULL, *oldest = NULL;
+	size_t i;
+
+	if (!telemetry || source < 0 || destination < 0)
+		return NULL;
+	for (i = 0; i < telemetry->active_link_capacity; i++) {
+		struct wmdt_active_link_state *entry = &telemetry->active_links[i];
+
+		if (entry->active && entry->source == source &&
+		    entry->destination == destination &&
+		    entry->frequency_mhz == frequency_mhz)
+			return entry;
+		if (!entry->active && !free_slot)
+			free_slot = entry;
+		if (entry->active && (!oldest ||
+		    entry->last_seen_usec < oldest->last_seen_usec))
+			oldest = entry;
+	}
+	if (!create)
+		return NULL;
+	if (!free_slot) {
+		free_slot = oldest;
+		telemetry->active_link_evictions++;
+		telemetry_event(ctx, WMDC_EVENT_ACTIVE_LINK_EVICTED,
+			free_slot->source, free_slot->destination,
+			free_slot->frequency_mhz, 0, 0);
+	}
+	*free_slot = (struct wmdt_active_link_state) {
+		.active = true,
+		.source = source,
+		.destination = destination,
+		.frequency_mhz = frequency_mhz,
+		.first_seen_usec = telemetry_now_usec(),
+	};
+	telemetry_event(ctx, WMDC_EVENT_LINK_ACTIVE, source, destination,
+			frequency_mhz, 0, 0);
+	return free_slot;
+}
+
+static void telemetry_update_link_common(struct wmd_telemetry *telemetry,
+					 struct wmdt_active_link_state *link,
+					 const struct frame *frame)
+{
+	if (!link)
+		return;
+	link->last_update_sequence = telemetry->sequence;
+	link->last_seen_usec = telemetry_now_usec();
+	link->last_signal_dbm = frame->signal;
+	link->last_snr_db = frame->telemetry_snr_db;
+	link->last_per_million = frame->telemetry_per_million;
+	link->last_type = telemetry_frame_type(frame);
+	link->last_subtype = telemetry_frame_subtype(frame);
+	link->last_access_category = frame->telemetry_access_category;
+}
+
+static int telemetry_count_active_links(const struct wmd_telemetry *telemetry)
+{
+	size_t i;
+	int count = 0;
+
+	for (i = 0; i < telemetry->active_link_capacity; i++)
+		count += telemetry->active_links[i].active;
+	return count;
+}
+
+static int telemetry_count_radio_frequencies(const struct wmd_telemetry *telemetry)
+{
+	size_t i;
+	int count = 0;
+
+	for (i = 0; i < telemetry->radio_frequency_capacity; i++)
+		count += telemetry->radio_frequencies[i].active;
+	return count;
+}
+
+static int telemetry_count_vifs(const struct wmd_telemetry *telemetry)
+{
+	size_t i;
+	int count = 0;
+
+	for (i = 0; i < telemetry->vif_capacity; i++)
+		count += telemetry->vifs[i].active;
+	return count;
+}
 
 static int station_index(struct wmediumd *ctx, const uint8_t *address)
 {
@@ -102,6 +423,9 @@ static int send_info(struct wmd_control_client *client, uint16_t opcode)
 	}
 	if (client->read_only)
 		capabilities |= WMDC_CAP_READ_ONLY;
+	if (client->telemetry)
+		capabilities |= WMDC_CAP_TELEMETRY | WMDC_CAP_PAGED_DUMPS |
+			WMDC_CAP_VIF_OWNERSHIP | WMDC_CAP_EVENT_RING;
 	struct wmdc_info info = {
 		.instance_hi = htobe64(ctx->control_instance_hi),
 		.instance_lo = htobe64(ctx->control_instance_lo),
@@ -141,6 +465,246 @@ int wmd_get_link_snr(struct wmediumd *ctx, struct station *sender,
 	return ctx->get_link_snr(ctx, sender, receiver);
 }
 
+void wmd_telemetry_record_tx(struct wmediumd *ctx, struct frame *frame,
+			     struct station *destination, int access_category,
+			     unsigned int attempts, unsigned int retries,
+			     bool acked, bool no_ack, bool offchannel,
+			     int snr_db, double error_prob,
+			     uint64_t queue_delay_usec)
+{
+	struct wmd_telemetry *telemetry = ctx->telemetry;
+	struct wmdt_radio_frequency_state *radio;
+	struct wmdt_active_link_state *link = NULL;
+	uint8_t type;
+	bool multicast;
+
+	if (!telemetry)
+		return;
+	telemetry->sequence++;
+	type = telemetry_frame_type(frame);
+	multicast = frame->data_len >= 10 && (frame->data[4] & 0x01);
+	frame->telemetry_access_category = access_category;
+	frame->telemetry_destination = destination ? destination->index : -1;
+	frame->telemetry_snr_db = snr_db;
+	frame->telemetry_per_million = telemetry_probability(error_prob);
+	frame->telemetry_attempts = attempts;
+	frame->telemetry_retries = retries;
+
+	telemetry->frames_seen++;
+	telemetry->bytes_seen += frame->data_len;
+	telemetry->frame_types[type]++;
+	telemetry->eapol_frames += telemetry_frame_is_eapol(frame);
+	telemetry->unicast_frames += !multicast;
+	telemetry->multicast_frames += multicast;
+	telemetry->tx_attempts += attempts;
+	telemetry->retries += retries;
+	if (!no_ack) {
+		telemetry->tx_acked += acked;
+		telemetry->tx_no_ack += !acked;
+	}
+	telemetry->queue_depth++;
+	if (telemetry->queue_depth > telemetry->queue_depth_max)
+		telemetry->queue_depth_max = telemetry->queue_depth;
+	telemetry->queue_delay_usec_last = queue_delay_usec;
+	if (queue_delay_usec > telemetry->queue_delay_usec_max)
+		telemetry->queue_delay_usec_max = queue_delay_usec;
+
+	radio = telemetry_radio_frequency(ctx, frame->sender->index,
+					  frame->freq, true);
+	if (radio) {
+		radio->last_update_sequence = telemetry->sequence;
+		radio->last_seen_usec = telemetry_now_usec();
+		radio->frames++;
+		radio->bytes += frame->data_len;
+		radio->frame_types[type]++;
+		radio->eapol_frames += telemetry_frame_is_eapol(frame);
+		radio->unicast_frames += !multicast;
+		radio->multicast_frames += multicast;
+		radio->attempts += attempts;
+		radio->retries += retries;
+		if (telemetry->queue_depth > radio->queue_depth_max)
+			radio->queue_depth_max = telemetry->queue_depth;
+		radio->last_type = type;
+		radio->last_subtype = telemetry_frame_subtype(frame);
+		radio->last_access_category = access_category;
+	}
+
+	if (destination) {
+		link = telemetry_active_link(ctx, frame->sender->index,
+			destination->index, frame->freq, true);
+		if (link) {
+			link->frames++;
+			link->bytes += frame->data_len;
+			link->attempts += attempts;
+			link->retries += retries;
+			link->acked += !no_ack && acked;
+			link->no_ack += !no_ack && !acked;
+			if (offchannel)
+				link->drops_offchannel++;
+			else if (!no_ack && !acked)
+				link->drops_per++;
+			telemetry_update_link_common(telemetry, link, frame);
+		}
+	}
+	if (offchannel) {
+		telemetry->drops_offchannel++;
+		if (radio)
+			radio->drops++;
+	} else if (!multicast && destination && !acked) {
+		telemetry->drops_per++;
+		if (radio)
+			radio->drops++;
+	} else if (!multicast && !destination) {
+		telemetry->drops_no_receiver++;
+		if (radio)
+			radio->drops++;
+	}
+}
+
+void wmd_telemetry_record_rx(struct wmediumd *ctx, struct frame *frame,
+			     struct station *destination,
+			     enum wmd_telemetry_outcome outcome,
+			     int signal_dbm, int snr_db, double error_prob)
+{
+	struct wmd_telemetry *telemetry = ctx->telemetry;
+	struct wmdt_radio_frequency_state *radio;
+	struct wmdt_active_link_state *link;
+
+	if (!telemetry)
+		return;
+	telemetry->sequence++;
+	frame->telemetry_snr_db = snr_db;
+	frame->telemetry_per_million = telemetry_probability(error_prob);
+	link = destination ? telemetry_active_link(ctx, frame->sender->index,
+		destination->index, frame->freq, true) : NULL;
+	radio = telemetry_radio_frequency(ctx, frame->sender->index,
+					  frame->freq, true);
+	if (frame->data_len >= 10 && (frame->data[4] & 0x01)) {
+		telemetry->multicast_candidates++;
+		if (link)
+			link->flags |= WMDC_LINK_MULTICAST;
+	}
+	switch (outcome) {
+	case WMD_TELEMETRY_RX_INJECTED:
+		telemetry->rx_injected++;
+		if (radio)
+			radio->rx_injected++;
+		if (link)
+			link->rx_injected++;
+		break;
+	case WMD_TELEMETRY_DROP_OFFCHANNEL:
+		telemetry->drops_offchannel++;
+		if (link)
+			link->drops_offchannel++;
+		break;
+	case WMD_TELEMETRY_DROP_CCA:
+		telemetry->drops_cca++;
+		if (link)
+			link->drops_cca++;
+		break;
+	case WMD_TELEMETRY_DROP_INTERFERENCE:
+		telemetry->drops_interference++;
+		if (link)
+			link->drops_interference++;
+		break;
+	case WMD_TELEMETRY_DROP_PER:
+		telemetry->drops_per++;
+		if (link)
+			link->drops_per++;
+		break;
+	case WMD_TELEMETRY_DROP_NO_RECEIVER:
+		telemetry->drops_no_receiver++;
+		if (link)
+			link->drops_no_receiver++;
+		break;
+	}
+	if (radio && outcome != WMD_TELEMETRY_RX_INJECTED)
+		radio->drops++;
+	telemetry_update_link_common(telemetry, link, frame);
+	if (link)
+		link->last_signal_dbm = signal_dbm;
+}
+
+void wmd_telemetry_frame_done(struct wmediumd *ctx)
+{
+	if (ctx->telemetry && ctx->telemetry->queue_depth)
+		ctx->telemetry->queue_depth--;
+}
+
+void wmd_telemetry_vif_update(struct wmediumd *ctx, const u8 *vif,
+			      struct station *owner, u32 frequency_mhz,
+			      bool changed)
+{
+	struct wmd_telemetry *telemetry = ctx->telemetry;
+	struct wmdt_vif_state *entry = NULL;
+	size_t i;
+	bool learned = false;
+
+	if (!telemetry || !owner)
+		return;
+	for (i = 0; i < telemetry->vif_capacity; i++) {
+		if (telemetry->vifs[i].active &&
+		    memcmp(telemetry->vifs[i].vif, vif, 6) == 0) {
+			entry = &telemetry->vifs[i];
+			break;
+		}
+		if (!telemetry->vifs[i].active && !entry)
+			entry = &telemetry->vifs[i];
+	}
+	if (!entry)
+		return;
+	learned = !entry->active;
+	if (!learned && !changed && entry->radio == owner->index &&
+	    entry->frequency_mhz == frequency_mhz)
+		return;
+	telemetry->sequence++;
+	entry->active = true;
+	memcpy(entry->vif, vif, 6);
+	entry->radio = owner->index;
+	entry->frequency_mhz = frequency_mhz;
+	entry->last_update_sequence = telemetry->sequence;
+	telemetry_event(ctx, learned ? WMDC_EVENT_VIF_LEARNED :
+			WMDC_EVENT_VIF_CHANGED, owner->index, -1,
+			frequency_mhz, 0, 0);
+}
+
+void wmd_telemetry_generation(struct wmediumd *ctx, u64 generation,
+			      bool frequency_qualified, u32 updates)
+{
+	if (!ctx->telemetry)
+		return;
+	telemetry_event(ctx, WMDC_EVENT_GENERATION_APPLIED, -1, -1, 0,
+			(int32_t)(generation & 0x7fffffff),
+			updates | (frequency_qualified ? 0x80000000U : 0));
+}
+
+void wmd_telemetry_netlink_rejection(struct wmediumd *ctx,
+			     struct station *source,
+			     struct station *destination, u32 frequency_mhz,
+			     int error, bool transient)
+{
+	struct wmd_telemetry *telemetry = ctx->telemetry;
+	struct wmdt_active_link_state *link;
+
+	if (!telemetry)
+		return;
+	telemetry->sequence++;
+	if (transient)
+		telemetry->netlink_clone_einval++;
+	else
+		telemetry->netlink_other_errors++;
+	link = source && destination ? telemetry_active_link(ctx, source->index,
+		destination->index, frequency_mhz, true) : NULL;
+	if (link) {
+		link->netlink_rejections++;
+		link->last_update_sequence = telemetry->sequence;
+		link->last_seen_usec = telemetry_now_usec();
+	}
+	telemetry_event(ctx, WMDC_EVENT_NETLINK_REJECTION,
+		source ? source->index : -1, destination ? destination->index : -1,
+		frequency_mhz, error, transient);
+}
+
 static int resolve_links(struct wmediumd *ctx, const uint8_t *payload,
 			 uint32_t count, struct resolved_update *resolved,
 			 bool require_value)
@@ -263,6 +827,7 @@ static int handle_apply(struct wmd_control_client *client,
 		ctx->snr_matrix[resolved[i].source * ctx->num_stas +
 			resolved[i].destination] = resolved[i].snr_db;
 	ctx->control_generation = generation;
+	wmd_telemetry_generation(ctx, generation, false, count);
 	free(resolved);
 	return send_response(client->loop.fd, WMDC_OP_APPLY, WMDC_OK,
 			generation, payload, payload_len);
@@ -369,6 +934,7 @@ static int handle_frequency_apply(struct wmd_control_client *client,
 			};
 	}
 	ctx->control_generation = generation;
