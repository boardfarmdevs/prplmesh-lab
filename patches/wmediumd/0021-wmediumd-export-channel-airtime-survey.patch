--- a/wmediumd/airtime.c
+++ b/wmediumd/airtime.c
@@ -0,0 +1,166 @@
+#include "airtime.h"
+
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+
+uint64_t wmd_airtime_now(void)
+{
+    struct timespec now;
+    clock_gettime(CLOCK_MONOTONIC, &now);
+    return (uint64_t)now.tv_sec * 1000000 + now.tv_nsec / 1000;
+}
+
+static struct wmd_airtime_channel *channel_find(struct wmd_airtime *state,
+                                                uint32_t frequency)
+{
+    unsigned int slot;
+    for (slot = 0; slot < WMD_AIRTIME_CHANNELS; slot++)
+        if (state->channels[slot] && state->channels[slot]->frequency == frequency)
+            return state->channels[slot];
+    return NULL;
+}
+
+static struct wmd_airtime_channel *channel_get(struct wmd_airtime *state,
+                                               uint32_t frequency, uint64_t now_us)
+{
+    unsigned int slot;
+    if (frequency < 2300 || frequency > 7125)
+        return NULL;
+    for (slot = 0; slot < WMD_AIRTIME_CHANNELS; slot++)
+        if (state->channels[slot] && state->channels[slot]->frequency == frequency)
+            return state->channels[slot];
+    for (slot = 0; slot < WMD_AIRTIME_CHANNELS; slot++) {
+        struct wmd_airtime_channel *channel = state->channels[slot];
+        if (channel && now_us - channel->cursor * 64 < 60000000)
+            continue;
+        if (!channel)
+            channel = calloc(1, sizeof(*channel));
+        else
+            memset(channel, 0, sizeof(*channel));
+        if (!channel)
+            return NULL;
+        channel->frequency = frequency;
+        channel->cursor = now_us / 64;
+        channel->start_us = channel->cursor * 64;
+        state->channels[slot] = channel;
+        return channel;
+    }
+    return NULL;
+}
+
+static void channel_advance(struct wmd_airtime_channel *channel, uint64_t now_us)
+{
+    uint64_t target = now_us / 64;
+    uint64_t remaining = target > channel->cursor ? target - channel->cursor : 0;
+    if (remaining > WMD_AIRTIME_BINS)
+        remaining = WMD_AIRTIME_BINS;
+    while (remaining--) {
+        uint64_t *cell = &channel->bins[channel->cursor % WMD_AIRTIME_BINS];
+        channel->busy_us += __builtin_popcountll(*cell);
+        *cell = 0;
+        channel->cursor++;
+    }
+    if (channel->cursor < target)
+        channel->cursor = target;
+}
+
+void wmd_airtime_invalidate(struct wmd_airtime *state, uint32_t frequency,
+                           uint64_t now_us)
+{
+    struct wmd_airtime_channel *channel = channel_find(state, frequency);
+    if (!channel)
+        return;
+    channel->overruns++;
+    channel->invalid_until_us = now_us + 64 * WMD_AIRTIME_BINS;
+}
+
+void wmd_airtime_record(struct wmd_airtime *state, uint32_t frequency,
+                       uint64_t now_us, uint64_t start_us, uint64_t duration_us)
+{
+    struct wmd_airtime_channel *channel = channel_find(state, frequency);
+    uint64_t end_us;
+    if (!channel || !duration_us)
+        return;
+    channel_advance(channel, now_us);
+    end_us = start_us + duration_us;
+    if (end_us < start_us || start_us < channel->cursor * 64 ||
+        end_us > (channel->cursor + WMD_AIRTIME_BINS) * 64) {
+        wmd_airtime_invalidate(state, frequency, now_us);
+        if (end_us > channel->invalid_until_us && end_us >= start_us)
+            channel->invalid_until_us = end_us;
+        return;
+    }
+    while (start_us < end_us) {
+        unsigned int offset = start_us % 64;
+        unsigned int length = end_us - start_us;
+        uint64_t mask;
+        if (length > 64 - offset)
+            length = 64 - offset;
+        mask = length == 64 ? UINT64_MAX : ((UINT64_C(1) << length) - 1) << offset;
+        channel->bins[(start_us / 64) % WMD_AIRTIME_BINS] |= mask;
+        start_us += length;
+    }
+}
+
+int wmd_airtime_read(struct wmd_airtime *state, uint32_t frequency,
+                     uint64_t now_us, struct wmd_airtime_sample *sample)
+{
+    struct wmd_airtime_channel *channel = channel_get(state, frequency, now_us);
+    if (!channel)
+        return -1;
+    channel_advance(channel, now_us);
+    memset(sample, 0, sizeof(*sample));
+    sample->frequency = frequency;
+    sample->start_us = channel->start_us;
+    sample->observed_us = channel->cursor * 64;
+    sample->busy_us = channel->busy_us;
+    sample->overruns = channel->overruns;
+    sample->flags = WMD_AIRTIME_MODEL_LEGACY20;
+    if (sample->observed_us > sample->start_us &&
+        sample->observed_us >= channel->invalid_until_us)
+        sample->flags |= WMD_AIRTIME_VALID;
+    return 0;
+}
+
+void wmd_airtime_free(struct wmd_airtime *state)
+{
+    unsigned int slot;
+    for (slot = 0; slot < WMD_AIRTIME_CHANNELS; slot++) {
+        free(state->channels[slot]);
+        state->channels[slot] = NULL;
+    }
+}
+
+int wmd_airtime_selftest(void)
+{
+    struct wmd_airtime state = {0};
+    struct wmd_airtime_sample sample;
+    int failures = 0;
+    wmd_airtime_read(&state, 5180, 6400, &sample);
+    failures += !!(sample.flags & WMD_AIRTIME_VALID);
+    wmd_airtime_read(&state, 5200, 6400, &sample);
+    for (unsigned int frequency = 5300; frequency < 5800; frequency += 5)
+        wmd_airtime_record(&state, frequency, 6400, 6410, 10);
+    failures += state.channels[2] != NULL;
+    wmd_airtime_record(&state, 5180, 6400, 6410, 80);
+    wmd_airtime_record(&state, 5180, 6400, 6450, 80);
+    wmd_airtime_record(&state, 5200, 6400, 6410, 200);
+    wmd_airtime_read(&state, 5180, 6656, &sample);
+    failures += sample.busy_us != 120;
+    failures += sample.observed_us - sample.start_us != 256;
+    failures += !(sample.flags & WMD_AIRTIME_VALID);
+    wmd_airtime_read(&state, 5200, 6656, &sample);
+    failures += sample.busy_us != 200;
+    wmd_airtime_read(&state, 5180, 6400000, &sample);
+    failures += sample.busy_us != 120;
+    wmd_airtime_record(&state, 5180, 6400000, 6400000, 64);
+    wmd_airtime_read(&state, 5180, 6400064, &sample);
+    failures += sample.busy_us != 184;
+    wmd_airtime_record(&state, 5180, 6400064, 8000000, 64);
+    wmd_airtime_read(&state, 5180, 6400128, &sample);
+    failures += !!(sample.flags & WMD_AIRTIME_VALID);
+    failures += sample.overruns != 1;
+    wmd_airtime_free(&state);
+    return failures;
+}
--- a/wmediumd/airtime.h
+++ b/wmediumd/airtime.h
@@ -0,0 +1,43 @@
+#ifndef WMD_AIRTIME_H
+#define WMD_AIRTIME_H
+
+#include <stdint.h>
+
+#define WMD_AIRTIME_CHANNELS 16
+#define WMD_AIRTIME_BINS 16384
+#define WMD_AIRTIME_VALID 1
+#define WMD_AIRTIME_MODEL_LEGACY20 2
+
+struct wmd_airtime_channel {
+    uint32_t frequency;
+    uint64_t start_us;
+    uint64_t cursor;
+    uint64_t busy_us;
+    uint64_t invalid_until_us;
+    uint64_t overruns;
+    uint64_t bins[WMD_AIRTIME_BINS];
+};
+
+struct wmd_airtime {
+    struct wmd_airtime_channel *channels[WMD_AIRTIME_CHANNELS];
+};
+
+struct wmd_airtime_sample {
+    uint32_t frequency;
+    uint32_t flags;
+    uint64_t start_us;
+    uint64_t observed_us;
+    uint64_t busy_us;
+    uint64_t overruns;
+};
+
+uint64_t wmd_airtime_now(void);
+int wmd_airtime_read(struct wmd_airtime *state, uint32_t frequency,
+                     uint64_t now_us, struct wmd_airtime_sample *sample);
+void wmd_airtime_record(struct wmd_airtime *state, uint32_t frequency,
+                       uint64_t now_us, uint64_t start_us, uint64_t duration_us);
+void wmd_airtime_invalidate(struct wmd_airtime *state, uint32_t frequency,
+                           uint64_t now_us);
+void wmd_airtime_free(struct wmd_airtime *state);
+int wmd_airtime_selftest(void);
+#endif
