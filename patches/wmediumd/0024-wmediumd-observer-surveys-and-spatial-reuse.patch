+static int handle_observer_surveys(struct wmd_control_client *client,
+                                  const void *payload, uint32_t length)
+{
+    struct observer_request {
+        uint8_t radio[6];
+        uint32_t frequency;
+    } __attribute__((packed));
+    struct observer_response {
+        uint8_t radio[6];
+        uint32_t frequency, flags;
+        uint64_t start_us, observed_us, busy_us, overruns;
+    } __attribute__((packed));
+    const struct observer_request *requests = payload;
+    struct observer_response responses[WMD_AIRTIME_CHANNELS];
+    int identities[WMD_AIRTIME_CHANNELS];
+    uint32_t count = length / sizeof(*requests);
+    uint64_t now_us = wmd_airtime_now();
+    int status = WMDC_OK;
+    if (!count || count > WMD_AIRTIME_CHANNELS || length % sizeof(*requests))
+        status = WMDC_ERR_LENGTH;
+    else if (client->ctx->survey_disabled)
+        status = WMDC_ERR_UNKNOWN;
+    for (uint32_t index = 0; status == WMDC_OK && index < count; index++) {
+        uint32_t frequency = be32toh(requests[index].frequency);
+        identities[index] = station_index(client->ctx, requests[index].radio);
+        if (identities[index] < 0)
+            status = WMDC_ERR_IDENTITY;
+        else if (frequency < 2300 || frequency > 7125)
+            status = WMDC_ERR_FREQUENCY;
+        for (uint32_t previous = 0; previous < index; previous++)
+            if (!memcmp(&requests[previous], &requests[index], sizeof(*requests)))
+                status = WMDC_ERR_VALUE;
+    }
+    for (uint32_t index = 0; status == WMDC_OK && index < count; index++) {
+        struct wmd_airtime_sample sample;
+        if (wmd_airtime_read_for(&client->ctx->airtime,
+                                client->ctx->visibility_contention ? identities[index] : -1,
+                be32toh(requests[index].frequency), now_us, &sample)) {
+            status = WMDC_ERR_INTERNAL;
+            break;
+        }
+        memcpy(responses[index].radio, requests[index].radio, 6);
+        responses[index].frequency = htobe32(sample.frequency);
+        responses[index].flags = htobe32(sample.flags);
+        responses[index].start_us = htobe64(sample.start_us);
+        responses[index].observed_us = htobe64(sample.observed_us);
+        responses[index].busy_us = htobe64(sample.busy_us);
+        responses[index].overruns = htobe64(sample.overruns);
+    }
+    return send_response(client->loop.fd, WMDC_OP_GET_OBSERVER_SURVEYS, status,
+                         client->ctx->control_generation, responses,
+                         status == WMDC_OK ? count * sizeof(*responses) : 0);
+}
