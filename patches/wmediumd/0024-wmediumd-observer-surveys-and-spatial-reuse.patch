+static int spatial_queue_selftest(void)
+{
+	int failures = 0;
+	for (int scenario = 0; scenario < 6; scenario++) {
+		struct wmediumd test = {0};
+		struct station stations[4] = {0};
+		struct station *pointers[4];
+		struct frame *frames[2];
+		int matrix[16];
+		INIT_LIST_HEAD(&test.stations);
+		test.sta_array = pointers;
+		test.num_stas = 4;
+		test.snr_matrix = matrix;
+		test.get_link_snr = selftest_pair_snr;
+		test.get_error_prob = packet_test_per;
+		test.get_fading_signal = packet_test_fading;
+		test.visibility_contention = scenario != 0;
+		for (int index = 0; index < 16; index++)
+			matrix[index] = -20;
+		matrix[1] = matrix[4] = matrix[11] = matrix[14] = 40;
+		if (scenario == 2)
+			matrix[6] = 20;
+		if (scenario == 5)
+			matrix[6] = 20;
+		for (int index = 0; index < 4; index++) {
+			pointers[index] = &stations[index];
+			stations[index].index = index;
+			stations[index].addr[0] = 0x02;
+			stations[index].addr[1] = 0xef;
+			stations[index].addr[5] = index;
+			station_init_queues(&stations[index]);
+			list_add_tail(&stations[index].list, &test.stations);
+			mc_update_vif_owner(&test, &stations[index], stations[index].addr,
+				scenario == 3 && index >= 2 ? 5200 : 5180);
+		}
+		for (int flow = 0; flow < 2; flow++) {
+			struct frame *frame = calloc(1, sizeof(*frame) + 1000);
+			struct ieee80211_hdr *header = (void *)frame->data;
+			frames[flow] = frame;
+			frame->sender = &stations[flow * 2];
+			frame->freq = scenario == 3 && flow == 1 ? 5200 : 5180;
+			frame->data_len = 1000;
+			frame->tx_rates_count = 1;
+			frame->tx_rates[0].idx = 7;
+			frame->tx_rates[0].count = 3;
+			header->frame_control[0] = 0x08;
+			if (scenario == 5 && flow == 1)
+				header->frame_control[0] = 0x00;
+			memcpy(header->addr1, stations[flow * 2 + 1].addr, ETH_ALEN);
+			memcpy(header->addr2, frame->sender->addr, ETH_ALEN);
+			if (scenario == 4)
+				header->addr1[0] = 0xff;
+			queue_frame(&test, frame->sender, frame);
+		}
+		bool independent = scenario == 1 || scenario == 3;
+		failures += (frames[0]->job.start == frames[1]->job.start) != independent;
+		if (scenario == 1) {
+			struct wmd_airtime_sample sample;
+			wmd_airtime_read_for(&test.airtime, 0, 5180, 6400, &sample);
+			wmd_airtime_read_for(&test.airtime, 2, 5180, 6400, &sample);
+			rf_record_airtime(&test, &stations[0], 5180, 6400, 6410, 128);
+			wmd_airtime_read_for(&test.airtime, 0, 5180, 6656, &sample);
+			failures += sample.busy_us != 128;
+			wmd_airtime_read_for(&test.airtime, 2, 5180, 6656, &sample);
+			failures += sample.busy_us != 0;
+			wmd_airtime_free(&test.airtime);
+		}
+		for (int flow = 0; flow < 2; flow++) {
+			list_del(&frames[flow]->list);
+			usfstl_sched_del_job(&frames[flow]->job);
+			free(frames[flow]);
+		}
+	}
+	printf("%s actual queue spatial reuse: global baseline, isolated flows, directed conflict, separate channel, multicast reservation, observer isolation and cross-priority reservation\n",
 		failures ? "FAIL" : "PASS");
 	return failures;
 }
