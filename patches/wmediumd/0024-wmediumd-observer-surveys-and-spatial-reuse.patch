+static bool rf_visible(struct wmediumd *ctx, struct station *source,
+		       struct station *observer, u32 frequency)
+{
+	return source == observer || wmd_get_link_snr(ctx, source, observer, frequency) + NOISE_LEVEL >= CCA_THRESHOLD;
+}
+
+static bool rf_flows_conflict(struct wmediumd *ctx, const struct frame *left,
+			     const struct frame *right)
+{
+	const struct ieee80211_hdr *left_header = (const void *)left->data;
+	const struct ieee80211_hdr *right_header = (const void *)right->data;
+	struct station *left_nodes[2], *right_nodes[2];
+	if (left->freq != right->freq)
+		return false;
+	if (!ctx->visibility_contention || is_multicast_ether_addr(left_header->addr1) ||
+	    is_multicast_ether_addr(right_header->addr1))
+		return true;
+	left_nodes[0] = left->sender;
+	left_nodes[1] = get_station_by_used_addr(ctx, (u8 *)left_header->addr1);
+	right_nodes[0] = right->sender;
+	right_nodes[1] = get_station_by_used_addr(ctx, (u8 *)right_header->addr1);
+	if (!left_nodes[1] || !right_nodes[1])
+		return true;
+	for (int left_index = 0; left_index < 2; left_index++)
+		for (int right_index = 0; right_index < 2; right_index++)
+			if (rf_visible(ctx, left_nodes[left_index], right_nodes[right_index], left->freq) ||
+			    rf_visible(ctx, right_nodes[right_index], left_nodes[left_index], left->freq))
+				return true;
+	return false;
+}
+
+static void rf_record_airtime(struct wmediumd *ctx, struct station *source, u32 frequency,
+			     uint64_t now_us, uint64_t start_us, uint64_t duration_us)
+{
+	if (ctx->survey_disabled)
+		return;
+	wmd_airtime_record(&ctx->airtime, frequency, now_us, start_us, duration_us);
+	if (!ctx->visibility_contention)
+		return;
+	for (unsigned int slot = 0; slot < WMD_AIRTIME_CHANNELS; slot++) {
+		struct wmd_airtime_channel *channel = ctx->airtime.channels[slot];
+		if (!channel || channel->frequency != frequency || channel->observer < 0 ||
+		    channel->observer >= ctx->num_stas)
+			continue;
+		if (rf_visible(ctx, source, ctx->sta_array[channel->observer], frequency))
+			wmd_airtime_record_channel(&ctx->airtime, channel,
+				now_us, start_us, duration_us);
+	}
+}
