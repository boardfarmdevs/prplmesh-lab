@@ -31,7 +33,23 @@
 namespace prplmesh {
 namespace controller {
 namespace actions {
 
+namespace {
+class ScopedVariant {
+public:
+    ScopedVariant() { amxc_var_init(&m_value); }
+    ~ScopedVariant() { amxc_var_clean(&m_value); }
+
+    ScopedVariant(const ScopedVariant &) = delete;
+    ScopedVariant &operator=(const ScopedVariant &) = delete;
+
+    amxc_var_t *get() { return &m_value; }
+
+private:
+    amxc_var_t m_value;
+};
+}
