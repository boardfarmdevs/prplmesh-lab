@@ -482,6 +482,30 @@
 int cfg_get_beerocks_credentials(const int radio_dir, char ssid[BPL_SSID_LEN],
                                  char pass[BPL_PASS_LEN], char sec[BPL_SEC_LEN])
 {
+    memset(ssid, 0, BPL_SSID_LEN);
+    memset(pass, 0, BPL_PASS_LEN);
+    memset(sec, 0, BPL_SEC_LEN);
+    if (radio_dir == BPL_RADIO_BACK) {
+        std::unordered_map<std::string, std::string> parameters;
+        if (!cfg_get_params(parameters, [](const std::string &name) {
+                return name.compare(0, 9, "backhaul_") == 0;
+            })) {
+            return RETURN_ERR;
+        }
+        const auto &configured_ssid = parameters["backhaul_ssid"];
+        const auto &configured_pass = parameters["backhaul_passphrase"];
+        const auto &configured_sec = parameters["backhaul_security"];
+        if (configured_ssid.empty() || configured_ssid.size() >= BPL_SSID_LEN ||
+            configured_pass.size() >= BPL_PASS_LEN || configured_sec.empty() ||
+            configured_sec.size() >= BPL_SEC_LEN ||
+            (configured_sec != BPL_WLAN_SEC_NONE_STR && configured_pass.empty())) {
+            return RETURN_ERR;
+        }
+        mapf::utils::copy_string(ssid, configured_ssid.c_str(), BPL_SSID_LEN);
+        mapf::utils::copy_string(pass, configured_pass.c_str(), BPL_PASS_LEN);
+        mapf::utils::copy_string(sec, configured_sec.c_str(), BPL_SEC_LEN);
+        return RETURN_OK;
+    }
     mapf::utils::copy_string(ssid, "test_beerocks_ssid", BPL_SSID_LEN);
     mapf::utils::copy_string(sec, "None", BPL_SEC_LEN);
     return RETURN_OK;
