Subject: [PATCH] nl80211: preserve candidate socket transaction identity

Retry interrupted sends and receives within one bounded exchange deadline.
Validate the echoed station, radio and frequency and abandon a desynchronized
batch. Never consume an earlier station response as a later station metric.

--- a/common/beerocks/bwl/nl80211/mon_wlan_hal_nl80211.cpp
+++ b/common/beerocks/bwl/nl80211/mon_wlan_hal_nl80211.cpp
@@ -15,6 +15,7 @@
 #include <easylogging++.h>
 
 #include <arpa/inet.h>
+#include <cerrno>
 #include <chrono>
 #include <cmath>
 #include <fstream>
@@ -783,14 +784,41 @@
     auto header = reinterpret_cast<wmdc_header *>(response);
     auto info = reinterpret_cast<wmdc_info *>(response + sizeof(*header));
     auto link = reinterpret_cast<wmdc_frequency_link *>(response + sizeof(*header));
+    auto exchange = [&](const void *payload, size_t payload_size) -> ssize_t {
+        auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds(1);
+        auto transfer = [&](bool transmit) -> ssize_t {
+            while (true) {
+                auto remaining = std::chrono::duration_cast<std::chrono::microseconds>(
+                    deadline - std::chrono::steady_clock::now()).count();
+                if (remaining <= 0) {
+                    errno = ETIMEDOUT;
+                    return -1;
+                }
+                timeval budget{remaining / 1000000, remaining % 1000000};
+                if (setsockopt(fd, SOL_SOCKET, transmit ? SO_SNDTIMEO : SO_RCVTIMEO,
+                               &budget, sizeof(budget)) != 0) {
+                    return -1;
+                }
+                auto result = transmit ? send(fd, payload, payload_size, MSG_NOSIGNAL)
+                                       : recv(fd, response, sizeof(response), 0);
+                if (result >= 0 || errno != EINTR) {
+                    return result;
+                }
+            }
+        };
+        auto written = transfer(true);
+        if (written != static_cast<ssize_t>(payload_size)) {
+            if (written >= 0) {
+                errno = EMSGSIZE;
+            }
+            return -1;
+        }
+        return transfer(false);
+    };
     request.header.magic = htonl(0x574d4443U);
     request.header.version = htons(1);
     request.header.opcode = htons(WMDC_OP_HELLO);
-    if (ok) {
-        ok = send(fd, &request.header, sizeof(request.header), 0) ==
-             static_cast<ssize_t>(sizeof(request.header));
-    }
-    auto length = ok ? recv(fd, response, sizeof(response), 0) : -1;
+    auto length = ok ? exchange(&request.header, sizeof(request.header)) : -1;
     if (length != static_cast<ssize_t>(sizeof(*header) + sizeof(*info)) ||
         ntohl(header->magic) != 0x574d4443U || ntohs(header->version) != 1 ||
         ntohs(header->opcode) != WMDC_OP_HELLO || ntohl(header->status) != WMDC_OK ||
@@ -824,16 +852,18 @@
         request.header.version = htons(1);
         request.header.opcode = htons(WMDC_OP_GET_FREQUENCY);
         request.header.payload_len = htonl(sizeof(request.link));
-        if (send(fd, &request, sizeof(request), 0) != static_cast<ssize_t>(sizeof(request))) {
-            return false;
-        }
-        auto received = recv(fd, response, sizeof(response), 0);
+        auto received = exchange(&request, sizeof(request));
         if (received != static_cast<ssize_t>(sizeof(*header) + sizeof(*link)) ||
             ntohl(header->magic) != 0x574d4443U || ntohs(header->version) != 1 ||
             ntohs(header->opcode) != WMDC_OP_GET_FREQUENCY ||
             ntohl(header->status) != WMDC_OK ||
             ntohl(header->payload_len) != sizeof(*link) ||
-            ntohl(link->frequency_mhz) != frequency_mhz) {
+            ntohl(link->frequency_mhz) != frequency_mhz ||
+            memcmp(link->source, request.link.source, sizeof(link->source)) != 0 ||
+            memcmp(link->destination, request.link.destination, sizeof(link->destination)) != 0) {
+            LOG(ERROR) << "Invalid wmediumd candidate response for " << sta_mac
+                       << " on " << get_iface_name() << ": bytes=" << received
+                       << " errno=" << (received < 0 ? errno : 0);
             return false;
         }
         snr_db = static_cast<int16_t>(ntohs(static_cast<uint16_t>(link->snr_db)));
@@ -857,10 +887,14 @@
             frequency_mhz = 5950 + 5 * channel;
         }
         int16_t snr_db = 0;
-        if (!frequency_mhz || !read_snr(station.first, frequency_mhz, snr_db)) {
+        if (!frequency_mhz) {
+            continue;
+        }
+        if (!read_snr(station.first, frequency_mhz, snr_db)) {
             LOG(DEBUG) << "No wmediumd candidate metric for " << station.first << " on "
                        << get_iface_name();
-            continue;
+            close(fd);
+            return false;
         }
         stats.push_back({tlvf::mac_from_string(station.first), snr_db - 91, channel,
                          operating_class, timestamp_ms});
