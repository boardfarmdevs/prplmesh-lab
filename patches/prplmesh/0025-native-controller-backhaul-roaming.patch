+bool BackhaulManager::handle_roaming_scan_request(std::shared_ptr<beerocks::beerocks_header> header,
+                                                  const sMacAddr &source)
+{
+    auto db = AgentDB::get();
+    if (source != db->controller_info.bridge_mac ||
+        header->actionhdr()->direction() != beerocks::BEEROCKS_DIRECTION_AGENT) {
+        return true;
+    }
+    auto request    = header->addClass<beerocks_message::cACTION_CONTROL_BACKHAUL_SCAN_REQUEST>();
+    auto active_hal = get_wireless_hal();
+    auto radio      = db->radio(db->backhaul.selected_iface_name);
+    if (!request || !active_hal || !radio || db->device_conf.certification_mode ||
+        request->topology_size() == 0 || request->topology_size() > 48 ||
+        header->actionhdr()->radio_mac() != radio->front.iface_mac ||
+        (m_roaming_scan_pending &&
+         std::chrono::steady_clock::now() - m_roaming_scan_started < std::chrono::seconds(3))) {
+        return true;
+    }
+    BackhaulRecoveryGuard::Peers peers;
+    for (size_t index = 0; index < request->topology_size(); ++index) {
+        auto entry = request->topology(index);
+        if (!std::get<0>(entry)) {
+            return false;
+        }
+        const auto &peer = std::get<1>(entry);
+        if (peer.bssid == beerocks::net::network_utils::ZERO_MAC ||
+            peer.agent == beerocks::net::network_utils::ZERO_MAC) {
+            return false;
+        }
+        peers[tlvf::mac_to_string(peer.bssid)] = {
+            tlvf::mac_to_string(peer.agent),
+            peer.parent == beerocks::net::network_utils::ZERO_MAC
+                ? ""
+                : tlvf::mac_to_string(peer.parent),
+            tlvf::mac_to_string(peer.station), peer.gateway != 0};
+    }
+    m_roaming_peers = std::move(peers);
+    m_roaming_lease.controller_seen(std::chrono::steady_clock::now());
+    m_roaming_scan_task     = header->id();
+    m_roaming_scan_sequence = request->sequence();
+    m_roaming_scan_radio    = header->actionhdr()->radio_mac();
+    m_roaming_scan_started  = std::chrono::steady_clock::now();
+    m_roaming_scan_pending  = true;
+    if (!FSM_IS_IN_STATE(OPERATIONAL) ||
+        m_backhaul_steering_bssid != beerocks::net::network_utils::ZERO_MAC ||
+        !active_hal->initiate_roaming_scan()) {
+        send_roaming_scan_response(false);
+        return true;
+    }
+    m_roaming_scan_bssid = active_hal->get_bssid();
+    return true;
+}
+
+bool BackhaulManager::recovery_candidate_allowed(const std::string &bssid)
+{
+    if (m_roaming_peers.empty()) {
+        return true;
+    }
+    if (bssid == m_roaming_orphan_parent &&
+        std::chrono::steady_clock::now() < m_roaming_orphan_until) {
+        return false;
+    }
+    auto db = AgentDB::get();
+    std::set<std::string> children;
+    for (const auto &radio : db->get_radios_list()) {
+        for (const auto &station : radio->associated_clients) {
+            children.insert(tlvf::mac_to_string(station.first));
+        }
+    }
+    return BackhaulRecoveryGuard::allowed(tlvf::mac_to_string(db->bridge.mac), bssid,
+                                          m_roaming_peers, children);
+}
+
+void BackhaulManager::send_roaming_scan_response(bool valid)
+{
+    m_roaming_scan_pending = false;
+    auto db                = AgentDB::get();
+    auto active_hal        = get_wireless_hal();
+    auto radio             = db->radio(db->backhaul.selected_iface_name);
+    std::vector<bwl::sScanResult> entries;
+    valid = valid && active_hal && radio && radio->front.iface_mac == m_roaming_scan_radio &&
+            m_backhaul_steering_bssid == beerocks::net::network_utils::ZERO_MAC &&
+            std::chrono::steady_clock::now() - m_roaming_scan_started <= std::chrono::seconds(3) &&
+            active_hal->update_status() && active_hal->is_connected() &&
+            active_hal->get_bssid() == m_roaming_scan_bssid &&
+            active_hal->get_roaming_scan_results(db->device_conf.back_radio.ssid, entries) &&
+            active_hal->update_status() && active_hal->is_connected() &&
+            active_hal->get_bssid() == m_roaming_scan_bssid;
+    if (entries.size() > 64) {
+        valid = false;
+    }
+    auto response =
+        message_com::create_vs_message<beerocks_message::cACTION_CONTROL_BACKHAUL_SCAN_RESPONSE>(
+            cmdu_tx, m_roaming_scan_task);
+    if (!response) {
+        return;
+    }
+    response->sequence()                      = m_roaming_scan_sequence;
+    response->valid()                         = valid;
+    response->completed_steering_mid()        = m_completed_steering_mid;
+    response->completed_steering_generation() = m_completed_steering_generation;
+    response->completed_steering_target()     = m_completed_steering_target;
+    response->station() = radio ? radio->back.iface_mac : beerocks::net::network_utils::ZERO_MAC;
+    response->current_bssid() = valid ? tlvf::mac_from_string(m_roaming_scan_bssid)
+                                      : beerocks::net::network_utils::ZERO_MAC;
+    if (valid && !response->alloc_entries(entries.size())) {
+        return;
+    }
+    if (valid) {
+        for (size_t index = 0; index < entries.size(); ++index) {
+            auto target = response->entries(index);
+            if (!std::get<0>(target)) {
+                return;
+            }
+            auto &entry   = std::get<1>(target);
+            entry.bssid   = entries[index].bssid;
+            entry.channel = entries[index].channel;
+            entry.rssi    = entries[index].rssi;
+        }
+    }
+    auto header                      = message_com::get_beerocks_header(cmdu_tx);
+    header->actionhdr()->radio_mac() = m_roaming_scan_radio;
+    header->actionhdr()->direction() = beerocks::BEEROCKS_DIRECTION_CONTROLLER;
+    send_cmdu_to_broker(cmdu_tx, db->controller_info.bridge_mac, db->bridge.mac);
+}
