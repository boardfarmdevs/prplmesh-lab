+#ifndef BACKHAUL_ROAMING_GUARD_H
+#define BACKHAUL_ROAMING_GUARD_H
+
+#include <chrono>
+#include <cstdint>
+#include <map>
+#include <set>
+#include <string>
+
+namespace beerocks {
+
+class BackhaulRecoveryLease {
+public:
+    using Clock = std::chrono::steady_clock;
+
+    void controller_seen(Clock::time_point now)
+    {
+        enabled         = true;
+        last_controller = now;
+        probes.clear();
+    }
+
+    void connected(Clock::time_point now)
+    {
+        last_connected = now;
+        disconnect_parent.clear();
+        probes.clear();
+    }
+
+    bool upstream_stale(Clock::time_point now) const
+    {
+        return enabled && now - last_controller > std::chrono::seconds(15);
+    }
+
+    bool probe_due(Clock::time_point now) const
+    {
+        return upstream_stale(now) && now - last_connected > std::chrono::seconds(15) &&
+               now - last_recovery > std::chrono::seconds(15) && probes.size() < 3 &&
+               (probes.empty() || now - last_probe >= std::chrono::seconds(2));
+    }
+
+    void probe_sent(uint16_t mid, Clock::time_point now)
+    {
+        probes[mid] = now;
+        last_probe  = now;
+    }
+
+    bool acknowledge(uint16_t mid, Clock::time_point now)
+    {
+        auto found = probes.find(mid);
+        if (found == probes.end() || now < found->second ||
+            now - found->second > std::chrono::seconds(8)) {
+            return false;
+        }
+        controller_seen(now);
+        return true;
+    }
+
+    bool due(Clock::time_point now) const
+    {
+        return upstream_stale(now) && probes.size() == 3 &&
+               now - last_probe >= std::chrono::seconds(2) &&
+               now - last_connected > std::chrono::seconds(15) &&
+               now - last_recovery > std::chrono::seconds(15);
+    }
+
+    void started(const std::string &parent, Clock::time_point now)
+    {
+        last_recovery     = now;
+        disconnect_parent = parent;
+        disconnect_until  = now + std::chrono::seconds(5);
+        probes.clear();
+    }
+
+    bool consume_disconnect(const std::string &parent, Clock::time_point now)
+    {
+        if (disconnect_parent.empty() || parent != disconnect_parent || now > disconnect_until) {
+            return false;
+        }
+        disconnect_parent.clear();
+        return true;
+    }
+
+private:
+    bool enabled = false;
+    Clock::time_point last_controller;
+    Clock::time_point last_connected;
+    Clock::time_point last_recovery;
+    Clock::time_point disconnect_until;
+    Clock::time_point last_probe;
+    std::string disconnect_parent;
+    std::map<uint16_t, Clock::time_point> probes;
+};
+
+struct BackhaulRecoveryPeer {
+    std::string agent;
+    std::string parent;
+    std::string station;
+    bool gateway = false;
+};
+
+class BackhaulRecoveryGuard {
+public:
+    using Peers = std::map<std::string, BackhaulRecoveryPeer>;
+
+    static bool allowed(const std::string &self, const std::string &candidate, const Peers &peers,
+                        const std::set<std::string> &children)
+    {
+        auto found = peers.find(candidate);
+        if (found == peers.end()) {
+            return false;
+        }
+        std::map<std::string, std::string> parents;
+        for (const auto &entry : peers) {
+            auto parent = entry.second.parent;
+            if (children.count(entry.second.station)) {
+                parent = self;
+            } else if (parent == self) {
+                parent.clear();
+            }
+            parents[entry.second.agent] = parent;
+        }
+        auto current = found->second.agent;
+        std::set<std::string> visited;
+        while (!current.empty()) {
+            if (current == self || !visited.insert(current).second) {
+                return false;
+            }
+            auto parent = parents.find(current);
+            if (parent == parents.end()) {
+                break;
+            }
+            current = parent->second;
+        }
+        return true;
+    }
+};
+
+}
+
