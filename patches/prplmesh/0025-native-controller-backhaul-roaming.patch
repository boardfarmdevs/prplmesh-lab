--- a/controller/src/beerocks/master/tasks/backhaul_roaming_policy.h
+++ b/controller/src/beerocks/master/tasks/backhaul_roaming_policy.h
@@ -0,0 +1,190 @@
+#ifndef BACKHAUL_ROAMING_POLICY_H
+#define BACKHAUL_ROAMING_POLICY_H
+
+#include <algorithm>
+#include <cstdint>
+#include <map>
+#include <set>
+#include <string>
+#include <vector>
+
+namespace son {
+
+struct BackhaulRoamingNode {
+    std::string parent;
+    bool gateway        = false;
+    bool connected      = false;
+    int rssi            = -128;
+    int64_t observed_ms = -1;
+};
+
+struct BackhaulRoamingCandidate {
+    std::string bssid;
+    std::string parent;
+    int rssi    = -128;
+    int channel = 0;
+};
+
+struct BackhaulRoamingReservation {
+    int attempts         = 0;
+    int64_t requested_ms = 0;
+
+    static bool settled(const std::string &target, const std::string &actual,
+                        uint16_t requested_mid, uint16_t completed_mid,
+                        const std::string &completed_target, uint32_t previous_generation,
+                        uint32_t completed_generation)
+    {
+        return actual == target || (requested_mid == completed_mid && completed_target == target &&
+                                    previous_generation != completed_generation);
+    }
+
+    void sent(int64_t now_ms)
+    {
+        requested_ms = now_ms;
+        ++attempts;
+    }
+
+    bool timed_out(int64_t now_ms) const { return attempts > 0 && now_ms - requested_ms >= 15000; }
+
+    bool retry_due(int64_t now_ms) const
+    {
+        return attempts > 0 && attempts < 3 && now_ms - requested_ms >= 35000;
+    }
+};
+
+class BackhaulRoamingPolicy {
+public:
+    using Nodes = std::map<std::string, BackhaulRoamingNode>;
+
+    static bool path(const Nodes &nodes, const std::string &start, const std::string &excluded,
+                     int64_t now_ms, int &bottleneck, int &hops)
+    {
+        std::set<std::string> visited;
+        auto current = start;
+        bottleneck   = 0;
+        hops         = 0;
+        while (!current.empty() && visited.size() < 32) {
+            if (current == excluded || !visited.insert(current).second) {
+                return false;
+            }
+            auto found = nodes.find(current);
+            if (found == nodes.end() || !found->second.connected) {
+                return false;
+            }
+            const auto &node = found->second;
+            if (node.gateway) {
+                return true;
+            }
+            if (node.observed_ms < 0 || now_ms < node.observed_ms ||
+                now_ms - node.observed_ms > 15000 || node.rssi < -127 || node.rssi >= 0) {
+                return false;
+            }
+            bottleneck = std::min(bottleneck, node.rssi);
+            ++hops;
+            current = node.parent;
+        }
+        return false;
+    }
+
+    static BackhaulRoamingCandidate select(const Nodes &nodes, const std::string &agent,
+                                           const std::vector<BackhaulRoamingCandidate> &candidates,
+                                           int64_t now_ms)
+    {
+        BackhaulRoamingCandidate selected;
+        auto current       = nodes.find(agent);
+        int old_bottleneck = 0;
+        int old_hops       = 0;
+        if (current == nodes.end() || !path(nodes, agent, "", now_ms, old_bottleneck, old_hops)) {
+            return selected;
+        }
+        int best_bottleneck = -128;
+        for (const auto &candidate : candidates) {
+            if (candidate.parent == current->second.parent || candidate.rssi < -80 ||
+                candidate.rssi >= 0 || candidate.rssi - current->second.rssi < 6) {
+                continue;
+            }
+            int parent_bottleneck = 0;
+            int parent_hops       = 0;
+            if (!path(nodes, candidate.parent, agent, now_ms, parent_bottleneck, parent_hops)) {
+                continue;
+            }
+            const int new_bottleneck = std::min(candidate.rssi, parent_bottleneck);
+            if (new_bottleneck < old_bottleneck ||
+                (parent_hops + 1 > old_hops && new_bottleneck <= old_bottleneck)) {
+                continue;
+            }
+            if (selected.bssid.empty() || new_bottleneck > best_bottleneck ||
+                (new_bottleneck == best_bottleneck && candidate.rssi > selected.rssi) ||
+                (new_bottleneck == best_bottleneck && candidate.rssi == selected.rssi &&
+                 candidate.bssid < selected.bssid)) {
+                selected        = candidate;
+                best_bottleneck = new_bottleneck;
+            }
+        }
+        return selected;
+    }
+
+    bool observe(const std::string &agent, const std::string &current_bssid,
+                 const std::string &candidate, int64_t now_ms)
+    {
+        auto &state = states[agent];
+        if (state.current != current_bssid) {
+            state                = State{};
+            state.current        = current_bssid;
+            state.retry_after_ms = now_ms + 10000;
+        }
+        if (candidate.empty()) {
+            state.candidate.clear();
+            state.samples = 0;
+            return false;
+        }
+        if (candidate != state.candidate || now_ms - state.last_ms > 12000) {
+            state.candidate = candidate;
+            state.since_ms  = now_ms;
+            state.samples   = 0;
+        }
+        state.last_ms = now_ms;
+        ++state.samples;
+        return state.samples >= 2 && now_ms - state.since_ms >= 4000 &&
+               now_ms >= state.retry_after_ms &&
+               (state.failed_candidate != candidate || state.failures < 3);
+    }
+
+    void completed(const std::string &agent, const std::string &target, bool success,
+                   int64_t now_ms)
+    {
+        auto &state = states[agent];
+        if (success) {
+            state.current  = target;
+            state.failures = 0;
+            state.failed_candidate.clear();
+            state.retry_after_ms = now_ms + 20000;
+        } else {
+            if (state.failed_candidate != target) {
+                state.failures = 0;
+            }
+            state.failed_candidate = target;
+            ++state.failures;
+            state.retry_after_ms = now_ms + std::min(60000, 20000 * state.failures);
+        }
+        state.candidate.clear();
+        state.samples = 0;
+    }
+
+private:
+    struct State {
+        std::string current;
+        std::string candidate;
+        std::string failed_candidate;
+        int64_t since_ms       = 0;
+        int64_t last_ms        = 0;
+        int64_t retry_after_ms = 0;
+        int samples            = 0;
+        int failures           = 0;
+    };
+    std::map<std::string, State> states;
+};
+
+}
+
+#endif
