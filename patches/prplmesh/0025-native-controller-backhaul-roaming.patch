+        std::string radio;
+        std::string station;
+        std::string parent_bssid;
+        uint16_t completed_steering_mid        = 0;
+        uint32_t completed_steering_generation = 0;
+        std::string completed_steering_target;
+        int rssi = -128;
+        std::vector<BackhaulRoamingCandidate> candidates;
+    };
+
+    db &database;
+    ieee1905_1::CmduMessageTx &transmit;
+    std::map<std::string, Observation> observations;
+    BackhaulRoamingPolicy policy;
+    uint32_t sequence     = 0;
