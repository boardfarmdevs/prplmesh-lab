--- a/controller/src/beerocks/master/tasks/backhaul_roaming_task.cpp
+++ b/controller/src/beerocks/master/tasks/backhaul_roaming_task.cpp
@@ -0,0 +1,340 @@
+#include "backhaul_roaming_task.h"
+#include "../son_actions.h"
+
+#include <beerocks/tlvf/beerocks_message.h>
+#include <easylogging++.h>
+#include <tlvf/wfa_map/tlvBackhaulSteeringRequest.h>
+#include <tlvf/wfa_map/tlvBackhaulSteeringResponse.h>
+
+namespace son {
+
+static int64_t roaming_now_ms()
+{
+    return std::chrono::duration_cast<std::chrono::milliseconds>(
+               std::chrono::steady_clock::now().time_since_epoch())
+        .count();
+}
+
+BackhaulRoamingTask::BackhaulRoamingTask(db &database, ieee1905_1::CmduMessageTx &transmit)
+    : task("native_backhaul_roaming"), database(database), transmit(transmit)
+{
+}
+
+BackhaulRoamingPolicy::Nodes BackhaulRoamingTask::topology(int64_t now_ms)
+{
+    BackhaulRoamingPolicy::Nodes nodes;
+    for (const auto &agent : database.get_all_connected_agents()) {
+        const auto identity = tlvf::mac_to_string(agent->al_mac);
+        auto &node          = nodes[identity];
+        node.gateway        = agent->is_gateway;
+        node.connected      = agent->state == beerocks::STATE_CONNECTED;
+        if (node.gateway) {
+            continue;
+        }
+        auto parent = agent->backhaul.parent_agent.lock();
+        if (!parent) {
+            node.connected = false;
+            continue;
+        }
+        node.parent = tlvf::mac_to_string(parent->al_mac);
+        auto found  = observations.find(identity);
+        if (found == observations.end() || !agent->backhaul.wireless_backhaul_radio) {
+            node.connected = false;
+            continue;
+        }
+        const auto &observation = found->second;
+        if (observation.parent_bssid != tlvf::mac_to_string(agent->backhaul.parent_interface) ||
+            observation.station != tlvf::mac_to_string(agent->backhaul.backhaul_interface) ||
+            observation.radio !=
+                tlvf::mac_to_string(agent->backhaul.wireless_backhaul_radio->radio_uid)) {
+            node.connected = false;
+            continue;
+        }
+        node.rssi        = observation.rssi;
+        node.observed_ms = observation.observed_ms;
+    }
+    return nodes;
+}
+
+void BackhaulRoamingTask::work()
+{
+    const auto now_ms = roaming_now_ms();
+    wait_for(500);
+    if (!moving_agent.empty()) {
+        auto found     = observations.find(moving_agent);
+        int bottleneck = 0;
+        int hops       = 0;
+        if (found != observations.end() && found->second.observed_ms > moving_started_ms &&
+            found->second.station == moving_station && found->second.radio == moving_radio &&
+            BackhaulRoamingPolicy::path(topology(now_ms), moving_agent, "", now_ms, bottleneck,
+                                        hops) &&
+            BackhaulRoamingReservation::settled(
+                moving_target, found->second.parent_bssid, steering_mid,
+                found->second.completed_steering_mid, found->second.completed_steering_target,
+                moving_completion_generation, found->second.completed_steering_generation)) {
+            if (found->second.parent_bssid != moving_target) {
+                LOG(INFO) << "native_backhaul_roaming completed_then_recovered agent="
+                          << moving_agent << " target=" << moving_target
+                          << " actual=" << found->second.parent_bssid << " mid=" << steering_mid;
+            }
+            complete(found->second.parent_bssid == moving_target, now_ms);
+        } else {
+            if (now_ms >= moving_topology_ms) {
+                son_actions::send_topology_query_msg(tlvf::mac_from_string(moving_agent), transmit,
+                                                     database);
+                auto parent = database.get_agent_by_bssid(tlvf::mac_from_string(moving_target));
+                if (parent) {
+                    son_actions::send_topology_query_msg(parent->al_mac, transmit, database);
+                }
+                moving_topology_ms = now_ms + 2000;
+            }
+            if (reservation.timed_out(now_ms) && !moving_timeout_logged) {
+                moving_timeout_logged = true;
+                LOG(WARNING) << "native_backhaul_roaming unresolved agent=" << moving_agent
+                             << " target=" << moving_target << " attempts=" << reservation.attempts
+                             << "; retaining topology reservation until native target is observed";
+            }
+            if (reservation.retry_due(now_ms) && found != observations.end() &&
+                now_ms - found->second.observed_ms <= 4000 &&
+                found->second.station == moving_station && found->second.radio == moving_radio &&
+                found->second.parent_bssid == moving_original &&
+                BackhaulRoamingPolicy::select(topology(now_ms), moving_agent,
+                                              found->second.candidates, now_ms)
+                        .bssid == moving_target) {
+                if (!issue_steering(moving_agent, moving_target, now_ms)) {
+                    reservation.requested_ms = now_ms;
+                }
+            }
+        }
+    }
+    for (const auto &agent : database.get_all_connected_agents()) {
+        if (agent->is_gateway || !agent->is_prplmesh ||
+            agent->backhaul.backhaul_iface_type == beerocks::IFACE_TYPE_ETHERNET) {
+            continue;
+        }
+        const auto identity = tlvf::mac_to_string(agent->al_mac);
+        auto &observation   = observations[identity];
+        if (now_ms < observation.next_query_ms) {
+            continue;
+        }
+        if (!agent->backhaul.wireless_backhaul_radio ||
+            agent->backhaul.backhaul_interface == beerocks::net::network_utils::ZERO_MAC) {
+            observation.next_query_ms = now_ms + 5000;
+            observation.requested_ms  = -1;
+            if (transmit.create(id,
+                                ieee1905_1::eMessageType::BACKHAUL_STA_CAPABILITY_QUERY_MESSAGE)) {
+                son_actions::send_cmdu_to_agent(agent->al_mac, transmit, database);
+            }
+            son_actions::send_topology_query_msg(agent->al_mac, transmit, database);
+            LOG(DEBUG) << "native_backhaul_roaming rediscovering backhaul radio agent=" << identity;
+            continue;
+        }
+        auto request = beerocks::message_com::create_vs_message<
+            beerocks_message::cACTION_CONTROL_BACKHAUL_SCAN_REQUEST>(transmit, id);
+        if (!request) {
+            continue;
+        }
+        std::vector<beerocks_message::sBackhaulRoamingTopologyEntry> peers;
+        for (const auto &peer : database.get_all_connected_agents()) {
+            auto parent = peer->backhaul.parent_agent.lock();
+            for (const auto &radio : peer->radios) {
+                for (const auto &bss : radio.second->bsses) {
+                    if (!bss.second->enabled || !bss.second->backhaul) {
+                        continue;
+                    }
+                    beerocks_message::sBackhaulRoamingTopologyEntry entry{};
+                    entry.bssid  = bss.second->bssid;
+                    entry.agent  = peer->al_mac;
+                    entry.parent = parent ? parent->al_mac : beerocks::net::network_utils::ZERO_MAC;
+                    entry.station = peer->backhaul.backhaul_interface;
+                    entry.gateway = peer->is_gateway;
+                    peers.push_back(entry);
+                }
+            }
+        }
+        if (peers.empty() || peers.size() > 48 || !request->alloc_topology(peers.size())) {
+            continue;
+        }
+        for (size_t index = 0; index < peers.size(); ++index) {
+            auto entry = request->topology(index);
+            if (!std::get<0>(entry)) {
+                return;
+            }
+            std::get<1>(entry) = peers[index];
+        }
+        request->sequence()       = ++sequence;
+        observation.sequence      = sequence;
+        observation.requested_ms  = now_ms;
+        observation.next_query_ms = now_ms + 5000;
+        observation.radio = tlvf::mac_to_string(agent->backhaul.wireless_backhaul_radio->radio_uid);
+        observation.station = tlvf::mac_to_string(agent->backhaul.backhaul_interface);
+        if (!son_actions::send_cmdu_to_agent(agent->al_mac, transmit, database,
+                                             observation.radio)) {
+            observation.requested_ms = -1;
+        }
+    }
+}
+
+void BackhaulRoamingTask::handle_response(std::string source,
+                                          std::shared_ptr<beerocks::beerocks_header> header)
+{
+    if (header->action_op() != beerocks_message::ACTION_CONTROL_BACKHAUL_SCAN_RESPONSE) {
+        return;
+    }
+    auto found = observations.find(source);
+    if (found == observations.end()) {
+        return;
+    }
+    auto response = header->addClass<beerocks_message::cACTION_CONTROL_BACKHAUL_SCAN_RESPONSE>();
+    auto &observation = found->second;
+    const auto now_ms = roaming_now_ms();
+    if (!response || observation.requested_ms < 0 || now_ms - observation.requested_ms > 4000 ||
+        response->sequence() != observation.sequence ||
+        tlvf::mac_to_string(header->actionhdr()->radio_mac()) != observation.radio ||
+        tlvf::mac_to_string(response->station()) != observation.station) {
+        return;
+    }
+    observation.requested_ms = -1;
+    observation.observed_ms  = -1;
+    observation.candidates.clear();
+    if (!response->valid() || response->entries_size() > 64) {
+        policy.observe(source, observation.parent_bssid, "", now_ms);
+        return;
+    }
+    observation.parent_bssid                  = tlvf::mac_to_string(response->current_bssid());
+    observation.completed_steering_mid        = response->completed_steering_mid();
+    observation.completed_steering_generation = response->completed_steering_generation();
+    observation.completed_steering_target =
+        tlvf::mac_to_string(response->completed_steering_target());
+    auto current_bss = database.get_bss(response->current_bssid());
+    if (!current_bss || !current_bss->backhaul) {
+        return;
+    }
+    const auto current_channel = database.get_radio_wifi_channel(current_bss->radio.radio_uid);
+    bool current_found         = false;
+    for (size_t index = 0; index < response->entries_size(); ++index) {
+        auto entry = response->entries(index);
+        if (!std::get<0>(entry)) {
+            return;
+        }
+        const auto &measured = std::get<1>(entry);
+        if (measured.channel != current_channel.get_channel() || measured.rssi < -127 ||
+            measured.rssi >= 0) {
+            continue;
+        }
+        if (measured.bssid == response->current_bssid()) {
+            observation.rssi = measured.rssi;
+            current_found    = true;
+            continue;
+        }
+        auto bss    = database.get_bss(measured.bssid);
+        auto parent = database.get_agent_by_bssid(measured.bssid);
+        if (!bss || !parent || !bss->backhaul || !bss->enabled || bss->ssid != current_bss->ssid ||
+            bss->radio.operating_class != current_bss->radio.operating_class ||
+            database.get_radio_wifi_channel(bss->radio.radio_uid).get_channel() !=
+                measured.channel) {
+            continue;
+        }
+        observation.candidates.push_back({tlvf::mac_to_string(measured.bssid),
+                                          tlvf::mac_to_string(parent->al_mac), measured.rssi,
+                                          measured.channel});
+    }
+    if (!current_found) {
+        return;
+    }
+    observation.observed_ms = now_ms;
+    const auto nodes        = topology(now_ms);
+    const auto candidate =
+        BackhaulRoamingPolicy::select(nodes, source, observation.candidates, now_ms);
+    const bool ready = policy.observe(source, observation.parent_bssid, candidate.bssid, now_ms);
+    LOG(DEBUG) << "native_backhaul_roaming observation agent=" << source
+               << " parent=" << observation.parent_bssid << " rssi=" << observation.rssi
+               << " eligible=" << candidate.bssid << " candidate_rssi=" << candidate.rssi;
+    if (!ready || !moving_agent.empty() || candidate.bssid.empty()) {
+        return;
+    }
+    if (!issue_steering(source, candidate.bssid, now_ms)) {
+        policy.completed(source, candidate.bssid, false, now_ms);
+    }
+}
+
+bool BackhaulRoamingTask::issue_steering(const std::string &source, const std::string &target,
+                                         int64_t now_ms)
+{
+    auto &observation = observations[source];
+    auto bss          = database.get_bss(tlvf::mac_from_string(target));
+    if (!bss || !transmit.create(++steering_mid,
+                                 ieee1905_1::eMessageType::BACKHAUL_STEERING_REQUEST_MESSAGE)) {
+        return false;
+    }
+    auto steering = transmit.addClass<wfa_map::tlvBackhaulSteeringRequest>();
+    if (!steering) {
+        return false;
+    }
+    steering->backhaul_station_mac() = tlvf::mac_from_string(observation.station);
+    steering->target_bssid()         = tlvf::mac_from_string(target);
+    steering->target_channel_number() =
+        database.get_radio_wifi_channel(bss->radio.radio_uid).get_channel();
+    steering->operating_class() = bss->radio.operating_class;
+    if (!son_actions::send_cmdu_to_agent(tlvf::mac_from_string(source), transmit, database)) {
+        return false;
+    }
+    if (moving_agent.empty()) {
+        moving_original              = observation.parent_bssid;
+        moving_completion_generation = observation.completed_steering_generation;
+        moving_first_ms              = now_ms;
+        reservation                  = BackhaulRoamingReservation{};
+    }
+    moving_agent          = source;
+    moving_station        = observation.station;
+    moving_radio          = observation.radio;
+    moving_target         = target;
+    moving_started_ms     = now_ms;
+    moving_topology_ms    = now_ms;
+    moving_timeout_logged = false;
+    reservation.sent(now_ms);
+    steering_acknowledged = false;
+    LOG(INFO) << "native_backhaul_roaming request agent=" << source << " station=" << moving_station
+              << " old=" << observation.parent_bssid << " target=" << moving_target
+              << " old_rssi=" << observation.rssi << " attempt=" << reservation.attempts
+              << " mid=" << steering_mid;
+    return true;
+}
+
+bool BackhaulRoamingTask::handle_ieee1905_1_msg(const sMacAddr &source,
+                                                ieee1905_1::CmduMessageRx &message)
+{
+    if (message.getMessageType() != ieee1905_1::eMessageType::BACKHAUL_STEERING_RESPONSE_MESSAGE ||
+        tlvf::mac_to_string(source) != moving_agent || message.getMessageId() != steering_mid) {
+        return false;
+    }
+    auto response = message.getClass<wfa_map::tlvBackhaulSteeringResponse>();
+    if (!response || tlvf::mac_to_string(response->target_bssid()) != moving_target ||
+        tlvf::mac_to_string(response->backhaul_station_mac()) != moving_station) {
+        return false;
+    }
+    if (response->result_code() != wfa_map::tlvBackhaulSteeringResponse::eResultCode::SUCCESS) {
+        LOG(WARNING) << "native_backhaul_roaming response rejected agent=" << moving_agent
+                     << "; retaining reservation for late native completion";
+    } else {
+        steering_acknowledged                    = true;
+        observations[moving_agent].next_query_ms = 0;
+        son_actions::send_topology_query_msg(source, transmit, database);
+    }
+    return true;
+}
+
+void BackhaulRoamingTask::complete(bool success, int64_t now_ms)
+{
+    LOG(INFO) << "native_backhaul_roaming complete agent=" << moving_agent
+              << " target=" << moving_target << " verified=" << success
+              << " elapsed_ms=" << now_ms - moving_first_ms
+              << " response_seen=" << steering_acknowledged;
+    policy.completed(moving_agent, moving_target, success, now_ms);
+    moving_agent.clear();
+    moving_station.clear();
+    moving_target.clear();
+    steering_acknowledged = false;
+}
+
+}
