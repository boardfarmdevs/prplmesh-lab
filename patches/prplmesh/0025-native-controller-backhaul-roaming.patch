+#ifndef TOPOLOGY_QUERY_TRACKER_H
+#define TOPOLOGY_QUERY_TRACKER_H
+
+#include <chrono>
+#include <cstdint>
+#include <deque>
+
+namespace son {
+
+class TopologyQueryTracker {
+public:
+    using Clock = std::chrono::steady_clock;
+    using Time  = Clock::time_point;
+
+    static uint16_t next_mid()
+    {
+        static uint16_t previous = 0x4000;
+        if (++previous == 0) {
+            ++previous;
+        }
+        return previous;
+    }
+
+    void sent(uint16_t mid, Time now)
+    {
+        if (mid == 0) {
+            return;
+        }
+        if (requests.size() == 16) {
+            requests.pop_front();
+        }
+        requests.push_back({mid, now});
+    }
+
+    Time consume(uint16_t mid, Time now)
+    {
+        for (auto request = requests.begin(); request != requests.end(); ++request) {
+            if (request->mid != mid) {
+                continue;
+            }
+            const auto sent_at = request->sent_at;
+            requests.erase(request);
+            return sent_at <= now && now - sent_at <= std::chrono::seconds(5) ? sent_at
+                                                                              : Time::min();
+        }
+        return Time::min();
+    }
+
+    static bool restores_same_owner(bool same_owner, bool missing_association, Time last_event,
+                                    Time query_sent, Time now)
+    {
+        return same_owner && missing_association && query_sent != Time::min() &&
+               query_sent > last_event && query_sent <= now &&
+               now - query_sent <= std::chrono::seconds(5);
+    }
+
+private:
+    struct Request {
+        uint16_t mid;
+        Time sent_at;
+    };
+    std::deque<Request> requests;
+};
+
+}
+
+#endif
