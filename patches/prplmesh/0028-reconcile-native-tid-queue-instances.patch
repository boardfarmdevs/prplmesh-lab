+bool AmbiorixImpl::sync_uint32_instances(const std::string &path, const std::string &key,
+                                       const std::string &value,
+                                       const std::map<uint32_t, uint32_t> &rows)
+{
+    auto object = find_object(path);
+    if (!object) {
+        return false;
+    }
+    amxd_trans_t transaction;
+    if (amxd_trans_init(&transaction) != amxd_status_ok) {
+        return false;
+    }
+    std::unique_ptr<amxd_trans_t, decltype(&amxd_trans_clean)> cleanup(&transaction,
+                                                                   amxd_trans_clean);
+    if (amxd_trans_set_attr(&transaction, amxd_tattr_change_ro, true) != amxd_status_ok) {
+        return false;
+    }
+    auto pending = rows;
+    bool changed = false;
+    amxd_object_for_each(instance, iterator, object)
+    {
+        auto instance = amxc_llist_it_get_data(iterator, amxd_object_t, it);
+        amxd_status_t status;
+        auto current_key = amxd_object_get_value(uint32_t, instance, key.c_str(), &status);
+        if (status != amxd_status_ok) {
+            return false;
+        }
+        auto desired = pending.find(current_key);
+        if (desired == pending.end()) {
+            if (amxd_trans_select_object(&transaction, object) != amxd_status_ok ||
+                amxd_trans_del_inst(&transaction, amxd_object_get_index(instance), nullptr) !=
+                    amxd_status_ok) {
+                return false;
+            }
+            changed = true;
+            continue;
+        }
+        auto current_value = amxd_object_get_value(uint32_t, instance, value.c_str(), &status);
+        if (status != amxd_status_ok) {
+            return false;
+        }
+        if (current_value != desired->second) {
+            if (amxd_trans_select_object(&transaction, instance) != amxd_status_ok ||
+                amxd_trans_set_value(uint32_t, &transaction, value.c_str(), desired->second) !=
+                    amxd_status_ok) {
+                return false;
+            }
+            changed = true;
+        }
+        pending.erase(desired);
+    }
+    for (const auto &row : pending) {
+        if (amxd_trans_select_object(&transaction, object) != amxd_status_ok ||
+            amxd_trans_add_inst(&transaction, 0, nullptr) != amxd_status_ok ||
+            amxd_trans_set_value(uint32_t, &transaction, key.c_str(), row.first) != amxd_status_ok ||
+            amxd_trans_set_value(uint32_t, &transaction, value.c_str(), row.second) != amxd_status_ok) {
+            return false;
+        }
+        changed = true;
+    }
+    return !changed || amxd_trans_apply(&transaction, Amxrt::getDatamodel()) == amxd_status_ok;
+}
