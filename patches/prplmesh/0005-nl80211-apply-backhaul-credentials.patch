From: prplMesh virtual-radio lab
Subject: [PATCH] nl80211: apply backhaul credentials without losing parent

The char-pointer wpa control overload rejected an output pointer whenever
the caller initialized its value to nullptr. This makes ADD_NETWORK fail
before sending anything to wpa_supplicant, because add_network() correctly
passes an empty output pointer for the function to populate.

The BSSID carried in an EasyMesh WSC M8 credential is not an association
target. prplMesh itself fills that field with the enrollee radio UID because
the controller does not know the agent's eventual BSSID. Do not pass this
placeholder to the station HAL as the target AP. Preserve the BSSID of an
already selected wireless parent while refreshing credentials; if there is
no current parent, allow wpa_supplicant to select a BSS for the supplied
SSID.

Together these changes prevent an agent from destroying a valid wireless
backhaul immediately after successful autoconfiguration.

--- a/agent/src/beerocks/slave/backhaul_manager/backhaul_manager.cpp
+++ b/agent/src/beerocks/slave/backhaul_manager/backhaul_manager.cpp
@@ -1905,8 +1905,14 @@ bool BackhaulManager::handle_slave_backhaul_message(int fd, ieee1905_1::CmduMess
         // We just create a valid parameter for compilation purpose.
         std::pair<uint8_t, beerocks::eFreqType> channel =
             std::make_pair(0, beerocks::eFreqType::FREQ_24G);
+
+        // The BSSID attribute in an M8 credential is an enrollee identifier, not the BSSID of
+        // the parent AP. Preserve an already selected parent when credentials are refreshed.
+        // With no current parent, leave the BSSID unconstrained and let wpa_supplicant select a
+        // BSS advertising the configured backhaul SSID.
+        const auto parent_bssid = sta_wlan_hal->get_bssid();
         sta_wlan_hal->connect(config_data->ssid_str(), config_data->network_key_str(), sec, false,
-                              tlvf::mac_to_string(config_data->bssid_attr().data), channel, false);
+                              parent_bssid, channel, false);
         break;
     }
     case beerocks_message::ACTION_BACKHAUL_MLD_UPDATE_REQUEST: {
--- a/common/beerocks/bwl/nl80211/base_wlan_hal_nl80211.cpp
+++ b/common/beerocks/bwl/nl80211/base_wlan_hal_nl80211.cpp
@@ -608,7 +608,7 @@ bool base_wlan_hal_nl80211::wpa_ctrl_send_msg(const std::string &cmd,
 bool base_wlan_hal_nl80211::wpa_ctrl_send_msg(const std::string &cmd, char **reply,
                                               const std::string &ifname)
 {
-    if (!reply || !(*reply)) {
+    if (!reply) {
         LOG(ERROR) << "Invalid reply pointer!";
         return false;
     }
--- a/common/beerocks/bwl/nl80211/sta_wlan_hal_nl80211.cpp
+++ b/common/beerocks/bwl/nl80211/sta_wlan_hal_nl80211.cpp
@@ -116,7 +116,7 @@ bool sta_wlan_hal_nl80211::connect(const std::string &ssid, const std::string &p
                << ", freq type = " << channel.second << ", Sec = " << nl80211_security_val(sec)
                << ", mem_only_psk=" << int(mem_only_psk);
 
-    if (ssid.empty() || bssid.empty() || sec == WiFiSec::Invalid) {
+    if (ssid.empty() || sec == WiFiSec::Invalid) {
         LOG(ERROR) << "Invalid params!";
         return false;
     }
@@ -425,10 +425,17 @@ bool sta_wlan_hal_nl80211::set_network_params(int network_id, const std::string
         return false;
     }
 
-    // Set BSSID
-    if (!set_network(network_id, "bssid", bssid)) {
+    // An empty BSSID deliberately leaves BSS selection to wpa_supplicant. This is required when
+    // applying network-wide EasyMesh backhaul credentials, which do not identify a parent AP.
+    if (!bssid.empty() && !set_network(network_id, "bssid", bssid)) {
         LOG(ERROR) << "Failed setting bssid on interface " << get_iface_name();
         return false;
     }
+
+    // This station HAL is the Multi-AP backhaul STA and must include the Multi-AP association IE.
+    if (!set_network(network_id, "multi_ap_backhaul_sta", "1")) {
+        LOG(ERROR) << "Failed enabling Multi-AP backhaul mode on " << get_iface_name();
+        return false;
+    }
 
     // Optional: set frequency
