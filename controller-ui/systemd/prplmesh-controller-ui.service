[Unit]
Description=prplMesh host EasyMesh Controller UI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@SERVICE_USER@
WorkingDirectory=@PROJECT_ROOT@/controller-ui
Environment=EASYMESH_UI_LISTEN=0.0.0.0:8091
Environment=EASYMESH_TOPOLOGY_URL=http://127.0.0.1:8092/api/topology
Environment=EASYMESH_ROOM_URL=http://127.0.0.1:8891
Environment=EASYMESH_NETWORKS_FILE=config/networks-untagged.json
ExecStart=@PROJECT_ROOT@/controller-ui/bin/easymesh-controller
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
